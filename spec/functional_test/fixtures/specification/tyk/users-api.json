{
  "name": "Users API",
  "api_id": "users",
  "org_id": "default",
  "use_keyless": false,
  "proxy": {
    "listen_path": "/users-api/",
    "target_url": "http://users:8080/",
    "strip_listen_path": true
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true,
        "extended_paths": {
          "black_list": [
            { "path": "/admin", "method_actions": { "DELETE": { "action": "no_action", "code": 200 } } }
          ],
          "ignored": [
            { "path": "/health", "method_actions": { "GET": { "action": "no_action", "code": 200 } } }
          ],
          "url_rewrites": [
            { "path": "/v1/profile", "method": "PUT", "match_pattern": "/v1/profile", "rewrite_to": "/profile" }
          ]
        }
      }
    }
  }
}
