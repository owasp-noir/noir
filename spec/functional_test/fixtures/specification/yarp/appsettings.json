{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "ReverseProxy": {
    // Routes are keyed by route id.
    "Routes": {
      "r1": {
        "ClusterId": "c1",
        "Match": { "Path": "/api/{**catch-all}", "Methods": [ "GET", "POST" ] }
      },
      "r2": {
        "ClusterId": "c2",
        "Match": {
          "Path": "/orders/{id:int}",
          "Hosts": [ "shop.example.com" ],
          "QueryParameters": [ { "Name": "version", "Values": [ "2" ] } ],
          "Headers": [ { "Name": "X-Tenant" } ],
        }
      }
    },
    "Clusters": {
      "c1": { "Destinations": { "d1": { "Address": "https://api.internal/" } } }
    }
  }
}
