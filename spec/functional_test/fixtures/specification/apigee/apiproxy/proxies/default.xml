<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>VerifyAPIKey</Name></Step>
        </Request>
    </PreFlow>
    <Flows>
        <Flow name="getUser">
            <Condition>(proxy.pathsuffix MatchesPath "/users/*") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="createUser">
            <Condition>(proxy.pathsuffix MatchesPath "/users") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="reports">
            <Condition>(proxy.pathsuffix JavaRegex "^/reports/[0-9]+$") or (proxy.pathsuffix ~/ "/exports/**")</Condition>
        </Flow>
        <Flow name="unknownResource">
            <Request>
                <Step><Name>RaiseFault-UnknownResource</Name></Step>
            </Request>
        </Flow>
    </Flows>
    <HTTPProxyConnection>
        <BasePath>/v1/hr</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
