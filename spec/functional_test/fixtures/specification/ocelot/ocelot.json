{
  // Ocelot allows .NET JSON-with-comments
  "Routes": [
    {
      "UpstreamPathTemplate": "/posts/{postId}",
      "UpstreamHttpMethod": [ "Get", "Put" ],
      "DownstreamPathTemplate": "/api/posts/{postId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "posts", "Port": 443 } ]
    },
    {
      "UpstreamPathTemplate": "/health",
      "DownstreamPathTemplate": "/healthz",
    },
    {
      "UpstreamPathTemplate": "/units/{unitId}/updates?since={since}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/units/{unitId}/updates?since={since}"
    }
  ],
  "Aggregates": [
    {
      "RouteKeys": [ "posts", "comments" ],
      "UpstreamPathTemplate": "/feed"
    }
  ],
  "GlobalConfiguration": { "BaseUrl": "https://gateway.example.com" }
}
