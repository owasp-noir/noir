module Analyzer::Ruby
  class Rails < RubyEngine
    analyzer_for "ruby_rails"

    # Routes `devise_for :scope` generates, keyed by the model module that
    # turns them on (`devise :database_authenticatable, :registerable, ...`
    # in app/models/<scope>.rb). Each tuple is {METHOD, sub_path template,
    # controller group, action}: the template's `%{key}` slots are the
    # `path_names:` keys Devise lets an app rename (`sign_in: :login`), and
    # the group is the `controllers:` key that swaps the implementing
    # controller (`sessions: :sessions`).
    DEVISE_SESSION_ROUTES = [
      {"GET", "%{sign_in}", "sessions", "new"},
      {"POST", "%{sign_in}", "sessions", "create"},
      {"DELETE", "%{sign_out}", "sessions", "destroy"},
    ]
    DEVISE_MODULE_ROUTES = {
      "database_authenticatable" => DEVISE_SESSION_ROUTES,
      # devise-two-factor registers its module with `route: :session`.
      "two_factor_authenticatable" => DEVISE_SESSION_ROUTES,
      "registerable"               => [
        {"GET", "%{registration}/%{cancel}", "registrations", "cancel"},
        {"GET", "%{registration}/%{sign_up}", "registrations", "new"},
        {"GET", "%{registration}/%{edit}", "registrations", "edit"},
        {"PATCH", "%{registration}", "registrations", "update"},
        {"PUT", "%{registration}", "registrations", "update"},
        {"DELETE", "%{registration}", "registrations", "destroy"},
        {"POST", "%{registration}", "registrations", "create"},
      ],
      "recoverable" => [
        {"GET", "%{password}/new", "passwords", "new"},
        {"POST", "%{password}", "passwords", "create"},
        {"GET", "%{password}/edit", "passwords", "edit"},
        {"PATCH", "%{password}", "passwords", "update"},
        {"PUT", "%{password}", "passwords", "update"},
      ],
      "confirmable" => [
        {"GET", "%{confirmation}/new", "confirmations", "new"},
        {"POST", "%{confirmation}", "confirmations", "create"},
        {"GET", "%{confirmation}", "confirmations", "show"},
      ],
      "lockable" => [
        {"GET", "%{unlock}/new", "unlocks", "new"},
        {"POST", "%{unlock}", "unlocks", "create"},
        {"GET", "%{unlock}", "unlocks", "show"},
      ],
      "omniauthable" => [
        {"GET", "auth/:provider", "omniauth_callbacks", "passthru"},
        {"POST", "auth/:provider", "omniauth_callbacks", "passthru"},
        {"GET", "auth/:provider/callback", "omniauth_callbacks", ":provider"},
        {"POST", "auth/:provider/callback", "omniauth_callbacks", ":provider"},
      ],
    }
    # Modules assumed when `app/models/<scope>.rb` is not in the scan.
    # `:omniauthable` is opt-in and only emits routes when declared on the model.
    DEVISE_DEFAULT_MODULES = %w[database_authenticatable registerable recoverable confirmable lockable]
    # Devise's `Mapping#default_path_names`: every key names itself except
    # `registration`, which is empty (`/users/sign_up`, not `/users/registration/sign_up`).
    DEVISE_PATH_NAMES = {"sign_in" => "sign_in", "sign_out" => "sign_out", "sign_up" => "sign_up",
                         "password" => "password", "confirmation" => "confirmation", "unlock" => "unlock",
                         "registration" => "", "edit" => "edit", "cancel" => "cancel"}
    # Parameters Devise's built-in controllers read per `{group, action}`,
    # paired with the helper method that sanitizes them (`user[...]` nesting
    # dropped, matching `permit` extraction). Attached when the action is
    # handled by Devise itself or by a subclass that does not redefine that
    # helper.
    DEVISE_ACTION_PARAMS = {
      {"sessions", "create"}      => {"sign_in_params", %w[email password]},
      {"registrations", "create"} => {"sign_up_params", %w[email password password_confirmation]},
      {"registrations", "update"} => {"account_update_params", %w[email password password_confirmation current_password]},
      {"passwords", "create"}     => {"resource_params", %w[email]},
      {"passwords", "update"}     => {"resource_params", %w[reset_password_token password password_confirmation]},
      {"confirmations", "create"} => {"resource_params", %w[email]},
      {"unlocks", "create"}       => {"resource_params", %w[email]},
    }

    # Routes generated by Doorkeeper's `use_doorkeeper` (the de-facto
    # OAuth2 provider for Rails — Mastodon, GitLab, Discourse plugins,
    # …). Each tuple is {METHOD, sub_path, group, action}. `group`
    # matches the `skip_controllers` symbols so a `use_doorkeeper do
    # skip_controllers :applications end` block drops the right rows,
    # and indexes the `controllers foo: 'bar'` remap used to resolve
    # the implementing controller for params/callees. Paths are
    # appended to `/oauth` under the scope where `use_doorkeeper` runs.
    DOORKEEPER_ROUTES = [
      {"GET", "/oauth/authorize", "authorizations", "new"},
      {"POST", "/oauth/authorize", "authorizations", "create"},
      {"DELETE", "/oauth/authorize", "authorizations", "destroy"},
      {"POST", "/oauth/token", "tokens", "create"},
      {"POST", "/oauth/revoke", "tokens", "revoke"},
      {"POST", "/oauth/introspect", "tokens", "introspect"},
      {"GET", "/oauth/token/info", "token_info", "show"},
      {"GET", "/oauth/applications", "applications", "index"},
      {"POST", "/oauth/applications", "applications", "create"},
      {"GET", "/oauth/applications/new", "applications", "new"},
      {"GET", "/oauth/applications/:id", "applications", "show"},
      {"GET", "/oauth/applications/:id/edit", "applications", "edit"},
      {"PATCH", "/oauth/applications/:id", "applications", "update"},
      {"PUT", "/oauth/applications/:id", "applications", "update"},
      {"DELETE", "/oauth/applications/:id", "applications", "destroy"},
      {"GET", "/oauth/authorized_applications", "authorized_applications", "index"},
      {"DELETE", "/oauth/authorized_applications/:id", "authorized_applications", "destroy"},
    ]

    # `parse_options` runs on most DSL lines of every routes.rb file (scope,
    # namespace, resources, member/collection actions, verb routes, match) —
    # i.e. once per line in the main route-parsing hot loop. It used to build
    # two `Regex.new("...#{value_pattern}...")` regexes from scratch on every
    # call even though `value_pattern` is a fixed literal that never varies —
    # Crystal doesn't cache/memoize a `Regex.new(String)` call the way it
    # embeds a non-interpolated regex *literal* at compile time. Precompile
    # both patterns once at class load instead.
    PARSE_OPTIONS_VALUE_PATTERN = "nil|true\\b|false\\b|['\"][^'\"]*['\"]|:[a-zA-Z_]\\w*|\\[[^\\]]*\\]|%i[\\[\\(][^\\]\\)]*[\\]\\)]|%w[\\[\\(][^\\]\\)]*[\\]\\)]"
    PARSE_OPTIONS_KEY_VALUE_RE  = Regex.new("(\\w+):\\s*(#{PARSE_OPTIONS_VALUE_PATTERN})")
    PARSE_OPTIONS_HASHROCKET_RE = Regex.new(":(\\w+)\\s*=>\\s*(#{PARSE_OPTIONS_VALUE_PATTERN})")

    struct Frame
      property kind : Symbol
      property path : String
      property controller_subdir : String
      property resource_name : String?
      property controller_path : String?
      property controller_scope : String?
      # `shallow do` / `resources ..., shallow: true`: nested resources below
      # this frame get shallow member routes.
      property? shallow : Bool
      # A shallow-nested resources frame: its member path stands on its own
      # (`comments/:id`, not `posts/:post_id/comments/:id`), so it replaces
      # the enclosing resources' paths for everything nested under it.
      property? shallow_member : Bool
      # The URL key a plural `resources` frame binds (`:id`, or `param:`),
      # which nested routes see as `<singular>_<param>`; nil on a singular
      # `resource`, whose URL carries no key.
      property param_name : String?
      # `with_options only: [:index] do`: options every route call in the
      # block takes unless it spells its own.
      property options : Hash(String, String)?

      def initialize(@kind : Symbol, @path : String = "", @controller_subdir : String = "",
                     @resource_name : String? = nil, @controller_path : String? = nil,
                     @controller_scope : String? = nil, @shallow : Bool = false,
                     @shallow_member : Bool = false, @param_name : String? = nil,
                     @options : Hash(String, String)? = nil)
      end
    end

    record ControllerData,
      path : String,
      param_type : String,
      params_method : Hash(String, Array(Param)),
      params_body_by_action : Hash(String, Array(Param)),
      params_query_by_action : Hash(String, Array(Param)),
      defined_actions : Set(String),
      helper_calls_by_action : Hash(String, Array(String)),
      callees_by_action : Hash(String, Array(Noir::RubyCalleeExtractor::Entry)),
      action_lines : Hash(String, Int32),
      # Per method, the helpers it reads only by `[:key]`, with those keys.
      helper_keys_by_action : Hash(String, Hash(String, Set(String))) = Hash(String, Hash(String, Set(String))).new

    # A `concern :name do ... end` body: its routing lines, replayed wherever
    # `resources ..., concerns: :name` or `concerns :name` names it. Rails
    # runs the block at that spot, so a `member do post :approve end` in it
    # hangs off the resource that names the concern.
    record ConcernBody, routes_path : String, lines : Array(RouteLine)

    # Everything one `routes.rb` walk carries: the file-wide constants plus the
    # mutable parse state the directive handlers below read and update. The
    # collections are shared by reference — a handler pushing a frame or
    # recording a concern mutates the very objects `parse_routes_file` walks —
    # while the doorkeeper config is swapped for fresh containers when a
    # `use_doorkeeper` block closes, so those two are reassignable.
    class RouteFileState
      getter framework_root : String
      getter routes_path : String
      getter parsed_route_files : Set(String)
      getter stack : Array(Frame)
      getter concerns : Hash(String, ConcernBody)
      # 1-based line of the `config/routes.rb` directive currently being
      # handled, so every endpoint the handlers emit can point at the line
      # the route is declared on rather than at the bare file.
      property current_line : Int32?
      # `use_doorkeeper do ... end` config accumulated while the block
      # is on top of the stack: `skip_controllers :foo` drops a group,
      # `controllers foo: 'bar'` remaps the implementing controller.
      property doorkeeper_skip : Set(String)
      property doorkeeper_controllers : Hash(String, String)

      def initialize(@framework_root : String, @routes_path : String,
                     @parsed_route_files : Set(String), @stack : Array(Frame),
                     @concerns : Hash(String, ConcernBody))
        @current_line = nil
        @doorkeeper_skip = Set(String).new
        @doorkeeper_controllers = Hash(String, String).new
      end

      # A fresh `Details` for the directive being handled. Deliberately not
      # memoized: every endpoint needs its own so the routes.rb line differs
      # per route, and a shared `Details` would also share the `code_paths`
      # array by reference across every endpoint of the file.
      def details : Details
        Details.new(PathInfo.new(@routes_path, @current_line))
      end
    end

    # One logical routing directive: the joined text of a (possibly
    # multi-line) statement plus the 1-based line its first token sits on.
    record RouteLine, text : String, line : Int32 do
      def with_text(new_text : String) : RouteLine
        RouteLine.new(new_text, @line)
      end
    end

    alias EngineMountKey = Tuple(String, String)

    @controller_data_cache = Hash(String, ControllerData).new
    # Maps a mountable-engine constant (e.g. `DiscoursePoll::Engine`) to the
    # path it is mounted at (`/polls`). A Rails engine's `routes.draw` block
    # holds engine-relative paths; the `mount` that anchors them usually
    # lives in a different file (a plugin.rb, the host app's routes), so we
    # resolve it cross-file once up front.
    @engine_mount_prefixes = Hash(EngineMountKey, String).new
    @known_files = Set(String).new
    @gemfile_public_roots : Array(Tuple(String, String))? = nil
    @public_file_candidates : Array(PublicFileCandidate)? = nil
    @callback_chain : Noir::RailsCallbackChain? = nil
    @framework_roots = [] of String
    @controller_roots = Hash(String, Array(String)).new
    @replaying_concerns = Set(String).new
    # Verbs a `def patch(*) end` in the draw block shadows on the mapper:
    # `resources` registers `update` through `patch`, so no PATCH route is
    # drawn, and explicit `patch "x"` lines are no-ops. Per draw (top-level
    # routes file plus the files it `draw`s, which share its mapper).
    @disabled_route_verbs = Set(String).new

    def analyze
      files = all_files.reject { |file| ruby_non_production_path?(file) }
      @known_files = Set(String).new(files)
      @callback_chain = nil
      @gemfile_public_roots = nil
      @public_file_candidates = nil
      @engine_mount_prefixes = build_engine_mount_map(files)

      framework_roots = discover_framework_roots(files, "config/routes.rb")
      framework_roots = base_paths if framework_roots.empty?
      @framework_roots = framework_roots
      @controller_roots.clear

      framework_roots.each do |framework_root|
        begin
          get_public_files(files, framework_root).each do |file|
            # Scan-base-relative, never absolute: the leftmost `/public/`
            # wins, so a `public/` directory above the scan base put the
            # whole intervening path into the served URL.
            if base_relative_path(file) =~ /\/public\/(.*)/
              relative_path = $1
              details = Details.new(PathInfo.new(file))
              @result << Endpoint.new("/#{relative_path}", "GET", details)
            end
          end
        rescue e
          logger.debug e
        end

        routes_path = "#{framework_root}/config/routes.rb"
        next unless known_file?(routes_path)
        next if hanami_router_file?(routes_path)

        parse_routes_file(routes_path, framework_root)
      end

      drop_foreign_segment_params
      @result
    end

    # `config/routes.rb` is the anchor for Rails and for Hanami alike, so in a
    # repo holding both, Rails parsed Hanami's route table as its own DSL. A
    # Hanami 2 routes file always names `Hanami::Routes` (it subclasses it), so
    # unlike the mirror check in the Hanami analyzer this one can key on the
    # positive marker.

    private def parse_routes_file(routes_path : String, framework_root : String)
      parsed_route_files = Set(String).new
      @disabled_route_verbs = Set(String).new
      parse_routes_file(routes_path, framework_root, parsed_route_files, [] of Frame, {} of String => ConcernBody)
    end

    private def known_file?(path : String) : Bool
      return @known_files.includes?(path) unless @known_files.empty?
      File.exists?(path)
    end

    private def discover_framework_roots(files : Array(String), anchor : String) : Array(String)
      suffix = anchor.starts_with?("/") ? anchor : "/#{anchor}"
      roots = [] of String

      files.each do |file|
        next unless file.ends_with?(suffix)
        next unless base_paths.any? { |base| path_under_root?(file, base) }

        root = file[0, file.size - suffix.size]
        roots << root unless roots.includes?(root)
      end

      roots
    end

    # `{<gemfile_dir>/public, expanded gemfile path}` for every Gemfile in
    # the scan. Built once and reused: `get_public_files` runs per
    # framework root, and re-deriving this list each time meant one full
    # pass over `files` per root (O(roots x files) on a monorepo with a
    # Gemfile per service).
    #
    # The memo ignores `files` after the first call, which is only sound
    # because `analyze` builds the list once and hands the same array to
    # every `get_public_files` call. A second caller passing a different
    # list would silently get the first one's roots — reset
    # `@gemfile_public_roots` (as `analyze` does) if that ever changes.
    private def gemfile_public_roots(files : Array(String)) : Array(Tuple(String, String))
      cached = @gemfile_public_roots
      return cached if cached

      locator = CodeLocator.instance
      built = [] of Tuple(String, String)
      files.each do |file|
        next unless File.basename(file) == "Gemfile"
        built << {File.join(File.dirname(file), "public"), locator.expanded_path_for(file)}
      end
      @gemfile_public_roots = built
      built
    end

    # A scanned file that sits beneath some Gemfile's `public/` directory,
    # with its expanded path and the expanded paths of every Gemfile whose
    # `public/` contains it.
    private record PublicFileCandidate, file : String, expanded : String, gemfiles : Array(String)

    private def get_public_files(files : Array(String), base_path : String) : Array(String)
      # A file is served for this framework root when it lives under the
      # root and under the `public/` of a Gemfile that also lives under the
      # root. Which `public/` directories contain a file does not depend on
      # the framework root, so that pass runs once (see
      # `public_file_candidates`) and each root only filters the result —
      # re-walking `files` per root was O(roots x files) on a monorepo with
      # one Rails app per service.
      public_file_candidates(files).compact_map do |candidate|
        next unless expanded_under_root?(candidate.expanded, base_path)
        next unless candidate.gemfiles.any? { |gemfile| expanded_under_root?(gemfile, base_path) }
        candidate.file
      end
    end

    # Built once per `analyze`, like `gemfile_public_roots`, and with the
    # same caveat about a caller passing a different `files` list.
    private def public_file_candidates(files : Array(String)) : Array(PublicFileCandidate)
      cached = @public_file_candidates
      return cached if cached

      gemfiles_by_public_root = Hash(String, Array(String)).new
      gemfile_public_roots(files).each do |public_root, gemfile_expanded|
        (gemfiles_by_public_root[Noir::PathScope.normalize_root(public_root)] ||= [] of String) << gemfile_expanded
      end

      built = [] of PublicFileCandidate
      unless gemfiles_by_public_root.empty?
        locator = CodeLocator.instance
        files.each do |file|
          next if FileHelper::PUBLIC_FILE_IGNORE.includes?(File.basename(file))
          expanded = locator.expanded_path_for(file)
          gemfiles = gemfiles_containing(expanded, gemfiles_by_public_root)
          built << PublicFileCandidate.new(file, expanded, gemfiles) unless gemfiles.empty?
        end
      end
      @public_file_candidates = built
      built
    end

    # The Gemfiles whose `public/` directory `expanded` sits strictly
    # beneath. Same strategy as `FileHelper#under_public_root?`: a linear
    # boundary test for a few roots, otherwise a lookup of each prefix that
    # ends at a `/public/` inside `expanded` (every key ends in `public`).
    private def gemfiles_containing(expanded : String, gemfiles_by_public_root : Hash(String, Array(String))) : Array(String)
      found = [] of String
      if gemfiles_by_public_root.size <= FileHelper::PUBLIC_ROOT_LINEAR_LIMIT
        gemfiles_by_public_root.each do |root, gemfiles|
          found.concat(gemfiles) if expanded != root && Noir::PathScope.under_normalized_root?(expanded, root)
        end
        return found
      end

      offset = 0
      while index = expanded.index(FileHelper::PUBLIC_SEGMENT, offset)
        if gemfiles = gemfiles_by_public_root[expanded[0, index + FileHelper::PUBLIC_SEGMENT.size - 1]]?
          found.concat(gemfiles)
        end
        offset = index + 1
      end
      found
    end

    private def parse_routes_file(routes_path : String, framework_root : String,
                                  parsed_route_files : Set(String),
                                  inherited_stack : Array(Frame),
                                  concerns : Hash(String, ConcernBody))
      expanded_routes_path = Noir::PathScope.expand(routes_path)
      parse_key = route_file_parse_key(expanded_routes_path, inherited_stack)
      return if parsed_route_files.includes?(parse_key)
      parsed_route_files << parse_key

      scan = RouteFileState.new(framework_root, routes_path,
        parsed_route_files, inherited_stack.dup, concerns)
      walk_route_lines(expand_inline_route_blocks(expand_static_loops(logical_route_lines(routes_path))), scan)
    end

    # Handles each logical routes.rb statement against the walk's state.
    private def walk_route_lines(route_lines : Array(RouteLine), scan : RouteFileState)
      local_string_vars = Hash(String, String).new

      route_lines.each do |route_line|
        line = route_line.text.strip
        next if line.empty?
        scan.current_line = route_line.line
        line = resolve_local_string_vars(line, local_string_vars)

        if name = current_concern_definition(scan.stack)
          record_concern_line(name, line, scan)
          next
        end

        # Handle `end` (top of stack pops one).
        if end_line?(line)
          close_route_block(scan)
          next
        end

        # Inside a `use_doorkeeper do ... end` block only configuration
        # DSL appears (`controllers`, `skip_controllers`, `skip_*`) —
        # never routes — so collect what we need and swallow the rest.
        if scan.stack.last?.try(&.kind) == :doorkeeper
          collect_doorkeeper_config(line, scan)
          next
        end

        opens_block = opens_do_block?(line) || opens_keyword_block?(line)

        # Outermost: Rails.application.routes.draw do ... end
        if line.starts_with?("Rails.application.routes.draw")
          scan.stack << Frame.new(:neutral) if opens_block
          next
        end

        # Mountable engine: `SomeEngine.routes.draw do ... end`. Its routes
        # are relative to where the host `mount`s the engine, so resolve the
        # mount prefix (built cross-file in @engine_mount_prefixes) and push
        # it as a scope. Unknown mounts (engine shipped as a library, host
        # not in scan) fall back to a transparent frame — same as before.
        if opens_block && (em = line.match(/^(?:::)?([A-Z][A-Za-z0-9_:]*)\.routes\.draw\b/))
          mount_prefix = @engine_mount_prefixes[{configured_base_for(scan.routes_path), em[1]}]?
          if mount_prefix && !mount_prefix.empty?
            scan.stack << Frame.new(:scope, path: mount_prefix)
          else
            scan.stack << Frame.new(:neutral)
          end
          next
        end

        # A routing directive is a bare word at the head of the line, so the
        # head token alone decides which handler runs — no two of the names
        # below can ever claim the same line (see `route_directive`). Anything
        # else is not routing DSL and only matters if it opens a block.
        directive, args = route_directive(line)
        case directive
        when "draw"           then handle_draw(args, scan)
        when "concern"        then handle_concern(args, opens_block, scan)
        when "namespace"      then handle_namespace(args, opens_block, scan)
        when "scope"          then handle_scope(args, opens_block, scan)
        when "controller"     then handle_controller(args, opens_block, scan)
        when "root"           then handle_root(args, scan)
        when "devise_for"     then handle_devise_for(args, opens_block, scan)
        when "devise_scope"   then scan.stack << Frame.new(:neutral) if opens_block
        when "use_doorkeeper" then handle_use_doorkeeper(opens_block, scan)
        when "mount"          then handle_mount(args, scan)
        when "concerns"       then handle_concerns(args, scan)
        when "resources", "resource"
          handle_resources(directive, args, opens_block, scan)
        when "member"     then scan.stack << Frame.new(:member) if opens_block
        when "collection" then scan.stack << Frame.new(:collection) if opens_block
        when "new"        then scan.stack << Frame.new(:new) if opens_block
        when "shallow"    then scan.stack << Frame.new(:neutral, shallow: true) if opens_block
        when "with_options"
          scan.stack << Frame.new(:with_options, options: parse_options(args)) if opens_block
        when "get", "post", "put", "patch", "delete", "head", "options", "query"
          handle_verb_route(directive.upcase, args, scan)
        when "match" then handle_match(args, scan)
        when "def"
          if m = args.match(/\A\s*(get|post|put|patch|delete)\b/)
            @disabled_route_verbs << m[1].upcase
          end
          # A multi-line `def` body ends with its own `end`; without a frame
          # that `end` would pop the enclosing scope.
          scan.stack << Frame.new(:neutral) unless line.matches?(/\bend\b/)
        else
          # Unknown DSL line that still opens a block (e.g. `constraints ... do`).
          scan.stack << Frame.new(:neutral) if opens_block
        end
      end
    end

    # Splits a routes.rb line into its leading directive name and the rest of
    # the line: `namespace :admin do` -> {"namespace", ":admin do"} and
    # `draw(:api)` -> {"draw", ":api)"}. A line that does not start with an
    # identifier yields an empty name, which matches no directive.
    #
    # The head token is the whole dispatch key. Every directive name is made of
    # word characters and the token stops at the first non-word character, so
    # two names can never both match one line (the shorter would have to be a
    # prefix of the longer, which would put a word character exactly where the
    # shorter one ends). That is why `parse_routes_file` may resolve the
    # directive once and `case` on it rather than testing each name in turn.
    private def route_directive(line : String) : Tuple(String, String)
      name_size = 0
      line.each_char do |char|
        break unless char.ascii_letter? || char == '_' || (name_size > 0 && char.ascii_number?)
        name_size += 1
      end
      return {"", ""} if name_size == 0

      name = line[0, name_size]
      rest = line[name_size, line.size - name_size].lstrip
      return {name, rest[1, rest.size - 1].strip} if rest.starts_with?("(")
      {name, rest.strip}
    end

    # Records `name = "literal"` assignments at any nesting and expands
    # `#{name}` interpolations with the ones seen so far.
    #
    # Routes files routinely DRY repeated prefixes into local
    # string vars (`base_c_route = "/c/:channel_title/:channel_id"`)
    # then use them with Ruby interpolation
    # (`get "#{base_c_route}/:message_id" => "ctrl#act"`). The
    # line-based parser saw the literal `#{base_c_route}` survive
    # into URLs. discourse/discourse alone parked ~153 phantom
    # routes with `#{...}` in them. Track the assignments as we
    # walk the file and expand interpolations before route
    # matching.
    #
    # We only resolve simple string-literal RHS; anything more complex (method
    # calls, concatenation) stays opaque and the original `#{...}` falls
    # through unchanged. Likewise only names we've actually seen are
    # substituted — unresolved `#{...}` survives, which is better than
    # producing an empty `/` placeholder.
    private def resolve_local_string_vars(line : String, local_string_vars : Hash(String, String)) : String
      if assign = line.match(/^([a-z_][a-z0-9_]*)\s*=\s*["']([^"']+)["']\s*$/)
        local_string_vars[assign[1]] = assign[2]
      end
      return line if local_string_vars.empty?

      line.gsub(/\#\{([a-z_][a-z0-9_]*)\}/) do |match|
        name = $~[1]
        local_string_vars[name]? || match
      end
    end

    # `end` pops the frame on top of the stack. Closing a `use_doorkeeper`
    # block is where its routes are emitted, now that any
    # `skip_controllers`/`controllers` config is known.
    private def close_route_block(scan : RouteFileState)
      return if scan.stack.empty?

      popped = scan.stack.pop
      return unless popped.kind == :doorkeeper

      emit_doorkeeper_routes(scan.framework_root, scan.stack, scan.doorkeeper_skip,
        scan.doorkeeper_controllers, scan.details)
      scan.doorkeeper_skip = Set(String).new
      scan.doorkeeper_controllers = Hash(String, String).new
    end

    private def collect_doorkeeper_config(line : String, scan : RouteFileState)
      if line.starts_with?("skip_controllers")
        parse_symbol_list(line["skip_controllers".size..]).each { |group| scan.doorkeeper_skip << group }
      elsif line.starts_with?("controllers")
        parse_options(line).each { |group, ctrl| scan.doorkeeper_controllers[group] = ctrl }
      end
    end

    # draw :admin / draw("api") loads config/routes/admin.rb inline.
    # Rails evaluates those files in the current mapper scope.
    private def handle_draw(args : String, scan : RouteFileState)
      parse_symbol_list(args).each do |draw_name|
        draw_path = File.join(scan.framework_root, "config", "routes", "#{draw_name}.rb")
        next unless known_file?(draw_path)
        parse_routes_file(draw_path, scan.framework_root, scan.parsed_route_files,
          scan.stack, scan.concerns)
      end
    end

    # concern :commentable do
    private def handle_concern(args : String, opens_block : Bool, scan : RouteFileState)
      return unless opens_block && (m = args.match(/^\s*:(\w+)/))
      scan.concerns[m[1]] = ConcernBody.new(scan.routes_path, [] of RouteLine)
      scan.stack << Frame.new(:concern, resource_name: m[1])
    end

    # A line inside a `concern` block is kept for replay, not routed: the
    # block's own `end` closes it, inner blocks are tracked so their `end`s
    # stay in the body.
    private def record_concern_line(name : String, line : String, scan : RouteFileState)
      if end_line?(line)
        return if scan.stack.pop.kind == :concern
      elsif opens_do_block?(line) || opens_keyword_block?(line)
        scan.stack << Frame.new(:neutral)
      end
      scan.concerns[name].lines << RouteLine.new(line, scan.current_line || 0)
    end

    # Runs the named concerns' bodies at `stack`, each line attributed to
    # where the concern declares it. A concern naming itself, directly or
    # through another, is expanded once.
    private def replay_concerns(names : Array(String), scan : RouteFileState, stack : Array(Frame))
      names.each do |name|
        next unless (body = scan.concerns[name]?) && @replaying_concerns.add?(name)
        # Rails runs the block on the mapper itself, outside any enclosing
        # `with_options`.
        replay = RouteFileState.new(scan.framework_root, body.routes_path, scan.parsed_route_files,
          stack.map { |f| f.kind == :with_options ? Frame.new(:neutral) : f }, scan.concerns)
        walk_route_lines(body.lines, replay)
        @replaying_concerns.delete(name)
      end
    end

    # namespace :foo do
    private def handle_namespace(args : String, opens_block : Bool, scan : RouteFileState)
      return unless m = args.match(/^\s*(?::(\w+)|['"]([^'"]+)['"])/)
      name = m[1]? || m[2]? || ""
      options = parse_options(args)
      namespace_path = normalize_route_prefix(options.has_key?("path") ? options["path"] : name)
      # `module:` overrides the controller namespace the name implies
      # (`namespace :profile, module: :profiles` -> Profiles::*).
      scan.stack << Frame.new(:namespace, path: namespace_path, controller_subdir: options["module"]? || name) if opens_block
    end

    # scope :name / scope "/admin" / scope path: ...
    private def handle_scope(args : String, opens_block : Bool, scan : RouteFileState)
      options = parse_options(args)
      scope_path = ""
      # A leading `:module => :x` is an option, not a scope name.
      if m = args.match(/^\s*:(\w+)\b(?!\s*=>)/)
        scope_path = m[1]
      elsif m = args.match(/^\s*['"]([^'"]+)['"]/)
        scope_path = normalize_route_prefix(m[1])
      elsif path_option = options["path"]?
        scope_path = normalize_route_prefix(path_option)
      end
      controller_subdir = options["module"]? || ""
      controller_scope = options["controller"]?
      scan.stack << Frame.new(:scope, path: scope_path, controller_subdir: controller_subdir,
        controller_scope: controller_scope) if opens_block
    end

    # controller :posts do ... end
    private def handle_controller(args : String, opens_block : Bool, scan : RouteFileState)
      controller_name = parse_first_route_name(args)
      scan.stack << Frame.new(:controller, controller_scope: controller_name) if opens_block && controller_name
    end

    # root "ctrl#action" / root to: "ctrl#action"
    private def handle_root(rest : String, scan : RouteFileState)
      stack = scan.stack
      prefix = current_path_prefix(stack)
      url = prefix.empty? ? "/" : "/#{prefix}"
      ctrl_action = parse_controller_action(rest, current_controller_scope(stack))
      ctrl_path = nil.as(String?)
      action_name = nil.as(String?)
      if ctrl_action
        ctrl_name, action = ctrl_action
        ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
        action_name = action
      end
      parse_route_verbs(rest, ["GET"]).each do |root_verb|
        action_params = action_name ? params_for_action(ctrl_path, action_name, root_verb) : ([] of Param)
        endpoint = Endpoint.new(url, root_verb, action_params, scan.details)
        attach_callees_for_action(endpoint, ctrl_path, action_name) if action_name
        endpoint.handler = handler_for_action(ctrl_path, action_name) if action_name
        @result << endpoint
      end
    end

    # devise_for :users, path: "u", path_names: { sign_in: :login },
    #                    controllers: { sessions: :sessions },
    #                    skip: [:registrations], only: [:sessions]
    private def handle_devise_for(args : String, opens_block : Bool, scan : RouteFileState)
      scan.stack << Frame.new(:neutral) if opens_block
      return unless m = args.match(/^\s*:(\w+)/)
      scope_name = m[1]
      # One flat parse: the keys inside Devise's `path_names:` and
      # `controllers:` hashes (sign_in, sessions, ...) never collide with
      # its top-level options, so nested hashes need no parser of their own.
      options = parse_options(args)
      only_list = parse_symbol_list(options["only"]?)
      skip_list = parse_symbol_list(options["skip"]?)
      prefix = current_path_prefix(scan.stack)
      base = "/#{prefix.empty? ? "" : "#{prefix}/"}#{options["path"]? || scope_name}"
      names = DEVISE_PATH_NAMES.merge(options.select(DEVISE_PATH_NAMES.keys))

      # Only the modules the model declares get routes: a `User` without
      # `:confirmable` has no `/users/confirmation`, and `:omniauthable`
      # routes only exist when the model turns `:omniauthable` on. A model
      # the scan cannot see keeps the default table rather than guessing.
      model = options["class_name"]?.try(&.underscore) || singularize(scope_name)
      modules = devise_modules(scan.framework_root, model) || DEVISE_DEFAULT_MODULES
      sign_out_verbs = devise_sign_out_verbs(scan.framework_root, options["sign_out_via"]?)
      # Unnamed controllers come from the enclosing `scope module:` /
      # `namespace` (`auth/sessions`), else from Devise itself.
      default_module = options["module"]? || current_controller_subdir(scan.stack).presence || "devise"
      # Two modules sharing a route kind (`:database_authenticatable` and
      # `:two_factor_authenticatable`) draw it once, as Devise does.
      seen = Set(Tuple(String, String, String, String)).new

      modules.each do |mod|
        next unless routes = DEVISE_MODULE_ROUTES[mod]?
        routes.each do |default_verb, template, group, action|
          next unless devise_module_allowed?(mod, group, only_list, skip_list)
          next unless seen.add?({default_verb, template, group, action})
          url = "#{base}/#{template % names}".gsub(%r{/+}, "/").rchop('/')
          ctrl_name = options[group]? || "#{default_module}/#{group}"
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, scan.stack)
          verbs = (group == "sessions" && action == "destroy") ? sign_out_verbs : [default_verb]
          verbs.each do |verb|
            action_params = devise_params_for_action(scan.framework_root, ctrl_path, group, action, verb)
            promote_path_params(action_params, url_param_names(url))
            endpoint = Endpoint.new(url, verb, action_params, scan.details)
            attach_callees_for_action(endpoint, ctrl_path, action)
            endpoint.handler = devise_handler(ctrl_name, ctrl_path, group, action)
            @result << endpoint
          end
        end
      end
    end

    # The app's own action when its controller (or an app ancestor) defines
    # it; otherwise the action is inherited from the gem and named as
    # Devise's (`devise/sessions#new`), with no file in the scan to point at.
    # An omniauth callback runs the app's per-provider method (`:provider`),
    # often defined by metaprogramming, so it names the app's controller
    # without a line. nil when the app names a controller the scan cannot see.
    private def devise_handler(ctrl_name : String, ctrl_path : String?, group : String, action : String) : Handler?
      if ctrl_path
        owner = action_owner(ctrl_path, action)
        return handler_for_action(owner, action, ctrl_path) if owner
        return handler_for_action(ctrl_path, action) if action.starts_with?(':')
      elsif ctrl_name != "devise/#{group}" || action.starts_with?(':')
        return
      end
      Handler.new("devise/#{group}##{action}")
    end

    private def devise_params_for_action(framework_root : String, ctrl_path : String?,
                                         group : String, action : String, verb : String) : Array(Param)
      params = params_for_action(ctrl_path, action, verb)
      return params unless entry = DEVISE_ACTION_PARAMS[{group, action}]?
      reader, names = entry
      param_type = devise_param_type(framework_root, ctrl_path)

      if ctrl_path && (data = extract_controller_data(ctrl_path)) && data.defined_actions.includes?(reader)
        reader_params = [] of Param
        merge_action_params(reader_params, data, reader, verb)
        reader_params.each do |param|
          resolved_type = (param.param_type == "form" && param_type == "json") ? "json" : param.param_type
          push_unique_param(params, Param.new(param.name, param.value, resolved_type))
        end
        return params
      end

      names.each do |name|
        push_unique_param(params, Param.new(name, "", param_type))
      end
      params
    end

    private def devise_param_type(framework_root : String, ctrl_path : String?) : String
      if ctrl_path && known_file?(ctrl_path)
        return "json" if extract_controller_data(ctrl_path).param_type == "json"
      end
      app_ctrl = "#{framework_root}/app/controllers/application_controller.rb"
      if known_file?(app_ctrl)
        source = ruby_source(app_ctrl)
        return "json" if source.matches?(/\brespond_to\s+:json\b|<\s*ActionController::API\b/)
      end
      "form"
    end

    private def devise_module_allowed?(mod : String, group : String, only : Array(String), skip : Array(String)) : Bool
      return false if skip.includes?("all")
      singular = group.rchop('s')
      return false if skip.includes?(mod) || skip.includes?(group) || skip.includes?(singular)
      return true if only.empty?
      only.includes?(mod) || only.includes?(group) || only.includes?(singular)
    end

    # `config.sign_out_via = :get` (or `[:get, :delete]`) in
    # `config/initializers/devise.rb` overrides the HTTP verb(s) of Devise's
    # `sign_out` route (`sessions#destroy`, default `DELETE`).
    private def devise_sign_out_verbs(framework_root : String, option : String?) : Array(String)
      verbs = parse_symbol_list(option).map(&.upcase).uniq!
      return verbs unless verbs.empty?

      init_path = "#{framework_root}/config/initializers/devise.rb"
      if known_file?(init_path)
        if m = ruby_source(init_path).match(/^\s*(?:config|Devise)\.sign_out_via\s*=\s*([^\n#]+)/m)
          verbs = parse_symbol_list(m[1]).map(&.upcase).uniq!
          return verbs unless verbs.empty?
        end
      end

      ["DELETE"]
    end

    # The symbols of every `devise :a, :b, ...` declaration (each may wrap
    # over lines) in the model and the app concerns it includes
    # (`include User::Omniauthable`); nil when the model file is missing or
    # declares none.
    private def devise_modules(framework_root : String, model : String) : Array(String)?
      model_path = "#{framework_root}/app/models/#{model}.rb"
      return unless known_file?(model_path)
      source = ruby_source(model_path)
      concerns = source.scan(/^\s*include\s+([A-Z][\w:]*)/m).compact_map do |inc|
        path = "#{framework_root}/app/models/concerns/#{inc[1].gsub("::", "/").underscore}.rb"
        ruby_source(path) if known_file?(path)
      end
      source = concerns.unshift(source).join('\n')
      mods = [] of String
      source.scan(/^\s*devise\s*\(?\s*((?::\w+\s*,?\s*(?:#[^\n]*)?\s*)+)/m) do |m|
        mods.concat(parse_symbol_list(m[1].gsub(/#[^\n]*/, "")))
      end
      return if mods.empty?
      mods << "omniauthable" if source.matches?(/\bomniauth_providers\s*:/) && !mods.includes?("omniauthable")
      mods
    end

    private def singularize(name : String) : String
      Noir::RubyInflector.singularize(name)
    end

    # use_doorkeeper / use_doorkeeper do ... end
    private def handle_use_doorkeeper(opens_block : Bool, scan : RouteFileState)
      if opens_block
        # Defer emission until `end` so skip_controllers/controllers
        # config inside the block is captured first.
        scan.stack << Frame.new(:doorkeeper)
      else
        emit_doorkeeper_routes(scan.framework_root, scan.stack, scan.doorkeeper_skip,
          scan.doorkeeper_controllers, scan.details)
      end
    end

    # mount Engine, at: "/path"  /  mount Engine => "/path"
    private def handle_mount(rest : String, scan : RouteFileState)
      at_path = nil
      if m = rest.match(/at:\s*['"]([^'"]+)['"]/)
        at_path = m[1]
      elsif m = rest.match(/=>\s*['"]([^'"]+)['"]/)
        at_path = m[1]
      end
      return unless at_path

      prefix = current_path_prefix(scan.stack)
      normalized = at_path.starts_with?("/") ? at_path : "/#{at_path}"
      url = prefix.empty? ? normalized : "/#{prefix}#{normalized}"
      @result << Endpoint.new(url, "GET", scan.details)
    end

    # concerns :commentable / concerns [:commentable, :taggable]
    private def handle_concerns(args : String, scan : RouteFileState)
      replay_concerns(parse_symbol_list(args), scan, scan.stack)
    end

    # resources :foo / resource :foo
    private def handle_resources(kind_kw : String, args : String, opens_block : Bool, scan : RouteFileState)
      stack = scan.stack
      return unless name = parse_first_route_name(args)
      options = with_options_for(stack).merge(parse_options(args))

      existing_controller_path = emit_resource_routes(scan.framework_root, stack, kind_kw, name, options)

      # A `module:` on the resources line also scopes nested
      # resources/routes inside its block, so carry it on the frame's
      # controller_subdir for children to inherit. Its concerns run in the
      # same scope as the block, ahead of it.
      frame = Frame.new(:resources, path: options["path"]?.try { |p| normalize_route_prefix(p) } || name, resource_name: options["as"]?.presence || name,
        controller_path: existing_controller_path, controller_subdir: options["module"]? || "",
        shallow: options["shallow"]? == "true", shallow_member: shallow_nested?(stack, options),
        param_name: resource_param_name(options, kind_kw == "resource"))
      concern_names = parse_symbol_list(options["concerns"]?)
      replay_concerns(concern_names, scan, stack + [frame]) unless concern_names.empty?
      stack << frame if opens_block
    end

    private def resource_param_name(options : Hash(String, String), singular : Bool) : String?
      singular ? nil : (options["param"]? || "id")
    end

    # The path a `resources` frame puts in front of a route under it, as Rails
    # routes it: `articles/:article_id` (`<singular>_<param>`, so `param:
    # :slug` gives `:article_slug`) for nested routes, `articles/:slug` on
    # `member`, bare `articles` on `collection`, `articles/new` on `new`. A
    # singular `resource` binds no key.
    private def resource_frame_path(f : Frame, route_scope : String?) : String
      return "#{f.path}/new" if route_scope == "new"
      return f.path if route_scope == "collection" || !(param = f.param_name)
      return "#{f.path}/:#{param}" if route_scope == "member"
      "#{f.path}/:#{singularize(f.resource_name.to_s)}_#{param}"
    end

    # `:slug` / `*path` keys spelled in a literal route string.
    private def url_param_names(url : String) : Array(String)
      url.scan(/[:*](\w+)/).map(&.[1])
    end

    # get "path" / post :action / delete "path" => "ctrl#action" — the HTTP
    # verb routes, in their three shapes (resource action symbol, standalone
    # symbol segment, path literal).
    private def handle_verb_route(verb : String, rest : String, scan : RouteFileState)
      return if @disabled_route_verbs.includes?(verb)
      stack = scan.stack
      options = parse_options(rest)

      route_scope = options["on"]? || current_custom_route_scope(stack)
      in_collection = route_scope == "collection"
      in_member = route_scope == "member"
      in_new = route_scope == "new"

      # `get :action` form inside member/collection/new blocks, inline
      # `on:` declarations, or directly nested in a resources block.
      if (am = rest.match(/^\s*:(\w+)\b/)) && (in_member || in_collection || in_new || parent_resources_frame(stack))
        segment = am[1]
        url = custom_resource_action_url(stack, segment, route_scope)
        if url
          parent = parent_resources_frame(stack)
          ctrl_path = parent.try(&.controller_path)
          action_name = controller_action_for_symbol_route(rest, segment)

          if ctrl_action = parse_controller_action(rest, current_controller_scope(stack))
            ctrl_name, parsed_action = ctrl_action
            ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
            action_name = parsed_action
          end

          action_params = params_for_action(ctrl_path, action_name, verb)
          promote_path_params(action_params, url_param_names(url))
          endpoint = Endpoint.new(url, verb, action_params, scan.details)
          attach_callees_for_action(endpoint, ctrl_path, action_name)
          endpoint.handler = handler_for_action(ctrl_path, action_name)
          @result << endpoint
        end
        return
      end

      # `get :action, to: "ctrl#action"` outside any resource block —
      # e.g. inside a bare `namespace :apps`. The symbol is a literal
      # path segment (`/api/v1/apps/verify_credentials`), not a resource
      # action. Requires an explicit destination so a bare `get :foo`
      # with no controller context isn't fabricated into a route. A
      # `controller :pages do` / `scope controller: :pages do` block is that
      # context: `get :privacy` there is `pages#privacy`.
      scoped_controller = current_controller_scope(stack)
      if (am = rest.match(/^\s*:(\w+)\b/)) && (scoped_controller || explicit_route_destination?(rest))
        segment = am[1]
        prefix = current_path_prefix(stack, route_scope)
        url = prefix.empty? ? "/#{segment}" : "/#{prefix}/#{segment}"

        ctrl_action = parse_controller_action(rest, scoped_controller)
        ctrl_action ||= {scoped_controller, segment} if scoped_controller && !explicit_route_destination?(rest)
        ctrl_path = nil.as(String?)
        action_name = nil.as(String?)
        action_params = [] of Param
        if ctrl_action
          ctrl_name, action = ctrl_action
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
          action_name = action
          action_params = params_for_action(ctrl_path, action, verb)
        end

        endpoint = Endpoint.new(url, verb, action_params, scan.details)
        attach_callees_for_action(endpoint, ctrl_path, action_name) if action_name
        endpoint.handler = handler_for_action(ctrl_path, action_name) if action_name
        @result << endpoint
        return
      end

      # `get "path"` / `get "path" => "..."` / `get "path", to: "..."`.
      # The path literal may be empty (`get "" => "admin#index"` maps a
      # namespace to its bare prefix), so accept `*` not `+`. A `#{...}`
      # interpolation can embed its own quotes (`get
      # "/#{ENV.fetch('X', 'bb')}/:area"`), so consume those blocks
      # wholesale instead of stopping at the first inner quote — that
      # truncation surfaced a malformed `/#{ENV.fetch('` route.
      return unless sm = rest.match(/^\s*(['"])((?:\#\{[^}]*\}|(?!\1).)*)\1/)

      # `/s/:id(/:title)` answers both `/s/:id` and `/s/:id/:title`.
      optional_route_variants(sm[2]).each do |raw_path|
        path = normalize_ruby_interpolation(raw_path)
        prefix = current_path_prefix(stack, route_scope)
        path_part = path.starts_with?("/") ? path : "/#{path}"
        url = prefix.empty? ? path_part : "/#{prefix}#{path_part}"
        # `get ""` / `get "/"` inside a namespace/scope composes to a
        # bare `/prefix/`; collapse the redundant trailing slash so the
        # URL matches the real route (`/admin`, not `/admin/`).
        url = url.rchop('/') if url.size > 1 && url.ends_with?('/')

        ctrl_action = parse_controller_action(rest, current_controller_scope(stack))
        action_params = [] of Param
        ctrl_path = nil.as(String?)
        action_name = nil.as(String?)
        if ctrl_action
          ctrl_name, action = ctrl_action
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
          action_name = action
          action_params = params_for_action(ctrl_path, action, verb)
        elsif inferred = infer_implicit_controller_action(path, rest, current_controller_scope(stack))
          ctrl_name, action = inferred
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
          action_name = action
          action_params = params_for_action(ctrl_path, action, verb)
        elsif parent = parent_resources_frame(stack)
          if action = infer_action_from_path(path)
            ctrl_path = parent.controller_path
            action_name = action
            action_params = params_for_action(ctrl_path, action, verb)
          end
        end

        promote_path_params(action_params, url_param_names(url))
        endpoint = Endpoint.new(url, verb, action_params, scan.details)
        attach_callees_for_action(endpoint, ctrl_path, action) if action = action_name
        endpoint.handler = handler_for_action(ctrl_path, action) if action = action_name
        @result << endpoint
      end
    end

    # `match` — Rails legacy multi-verb route. Requires `via:`
    # (or, on older codebases, defaults to ANY). Emits one
    # endpoint per verb listed under via, all sharing the
    # same path/controller#action.
    private def handle_match(rest : String, scan : RouteFileState)
      stack = scan.stack
      return unless sm = rest.match(/^\s*['"]([^'"]*)['"]/)

      optional_route_variants(sm[1]).each do |raw_path|
        path = normalize_ruby_interpolation(raw_path)
        prefix = current_path_prefix(stack, parse_options(rest)["on"]?)
        path_part = path.starts_with?("/") ? path : "/#{path}"
        url = prefix.empty? ? path_part : "/#{prefix}#{path_part}"
        url = url.rchop('/') if url.size > 1 && url.ends_with?('/')

        match_verbs = parse_match_verbs(rest)
        ctrl_action = parse_controller_action(rest, current_controller_scope(stack))

        ctrl_path = nil.as(String?)
        action_name = nil.as(String?)
        if ctrl_action
          ctrl_name, action = ctrl_action
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
          action_name = action
        elsif inferred = infer_implicit_controller_action(path, rest, current_controller_scope(stack))
          ctrl_name, action = inferred
          ctrl_path = find_controller_file(scan.framework_root, ctrl_name, stack)
          action_name = action
        end

        match_verbs.each do |match_verb|
          action_params = if name = action_name
                            params_for_action(ctrl_path, name, match_verb)
                          else
                            [] of Param
                          end
          promote_path_params(action_params, url_param_names(url))
          endpoint = Endpoint.new(url, match_verb, action_params, scan.details)
          attach_callees_for_action(endpoint, ctrl_path, action_name) if action_name
          endpoint.handler = handler_for_action(ctrl_path, action_name) if action_name
          @result << endpoint
        end
      end
    end

    # Options the enclosing `with_options` blocks hand a route call, inner
    # blocks over outer.
    private def with_options_for(stack : Array(Frame)) : Hash(String, String)
      merged = {} of String => String
      stack.each { |f| f.options.try { |options| merged.merge!(options) } }
      merged
    end

    private def current_concern_definition(stack : Array(Frame)) : String?
      if frame = stack.reverse.find { |f| f.kind == :concern }
        return frame.resource_name
      end
      nil
    end

    private def route_file_parse_key(path : String, stack : Array(Frame)) : String
      stack_key = stack.map do |frame|
        [
          frame.kind.to_s,
          frame.path,
          frame.controller_subdir,
          frame.resource_name || "",
          frame.controller_path || "",
          frame.controller_scope || "",
        ].join(":")
      end.join("|")

      "#{path}##{stack_key}"
    end

    # A `%w[...].each do |var|` / `%i[...].each_with_index do |var, i|`
    # block over a STATIC literal list unrolls to one copy of its body per
    # element with the loop variable's `#{var}` interpolations substituted.
    # discourse alone wraps ~46 routes in `%w[users u].each` — without this,
    # `get "#{root_path}/..."` leaks `{root_path}` into ~130 endpoints (a
    # fabricated path param) AND the real /users + /u variants are lost.
    #
    # Only literal `%w`/`%i` receivers are expanded: a dynamic
    # `Model.scopes.each do |s|` cannot be resolved to values at parse time,
    # so it is left for the normal parser (its block opens a neutral frame).
    LOOP_OPENER = /^%([wi])[\[\(\{]([^\]\)\}]*)[\]\)\}]\s*\.each(?:_with_index)?\s+do\s*\|\s*([a-z_]\w*)[^|]*\|\s*$/

    # noir scans arbitrary untrusted repos, so loop unrolling must not be a DoS
    # vector — expansion is multiplicative (elements ^ nesting). A crafted
    # `routes.rb` with deep nesting or a huge `%w[...]` list could otherwise
    # blow up CPU/memory. Real apps use tiny shallow lists (discourse's biggest
    # is the 2-element `%w[users u]`), so modest caps preserve all genuine
    # recall while bounding the worst case. Over a limit, the block is passed
    # through unexpanded (the pre-unrolling behavior — a transparent frame).
    MAX_LOOP_DEPTH  =      3
    MAX_LOOP_VALUES =    100
    MAX_LOOP_OUTPUT = 20_000

    # Unrolled copies keep the line of the body statement they came from:
    # a route written once inside `%w[a b].each do |x|` really is declared
    # on that one line, whichever value the copy carries.
    private def expand_static_loops(lines : Array(RouteLine), depth : Int32 = 0) : Array(RouteLine)
      return lines if depth > MAX_LOOP_DEPTH
      return lines unless lines.any?(&.text.matches?(LOOP_OPENER))

      result = [] of RouteLine
      index = 0
      while index < lines.size
        line = lines[index]
        if m = line.text.match(LOOP_OPENER)
          var = m[3]
          values = m[2].split(/\s+/).reject(&.empty?)

          # Walk to the `end` that closes this `.each do`, mirroring the main
          # parser's one-block-open-per-line / `end`-pops-one model.
          block_depth = 1
          body = [] of RouteLine
          cursor = index + 1
          while cursor < lines.size && block_depth > 0
            body_line = lines[cursor]
            if end_line?(body_line.text)
              block_depth -= 1
              break if block_depth == 0
            elsif opens_do_block?(body_line.text) || opens_keyword_block?(body_line.text)
              block_depth += 1
            end
            body << body_line
            cursor += 1
          end

          if values.size > MAX_LOOP_VALUES || result.size > MAX_LOOP_OUTPUT
            # Over budget: emit the block verbatim so the main parser handles
            # it as a neutral frame instead of unrolling an attacker-sized fan-out.
            (index..cursor).each { |i| result << lines[i] if i < lines.size }
          else
            expanded_body = expand_static_loops(body, depth + 1)
            # Precompile the substitution once per loop var (Crystal recompiles
            # an interpolated regex literal on every match).
            pattern = Regex.new("\\#\\{\\s*#{Regex.escape(var)}\\s*\\}")
            values.each do |value|
              break if result.size > MAX_LOOP_OUTPUT
              expanded_body.each { |unrolled| result << unrolled.with_text(unrolled.text.gsub(pattern, value)) }
            end
          end
          index = cursor + 1 # skip the closing `end`
        else
          result << line
          index += 1
        end
      end

      result
    end

    # Rails commonly writes compact inline route scopes:
    # `collection { get "preview" }` / `member { post :use }` /
    # `devise_scope :user do get "login", to: "devise/sessions#new" end`.
    # The parser is stack-based, so normalize these to the same do/end
    # structure before route extraction.
    INLINE_ROUTE_BLOCK  = /^(member|collection|new)\s*\{\s*(.+?)\s*\}\s*$/
    INLINE_DEVISE_SCOPE = /^devise_scope\b\s*\(?\s*(?::\w+|['"][^'"]+['"])\s*\)?\s*(?:\bdo\b\s*(.+?)\s*\bend|\{\s*(.+?)\s*\})\s*$/

    private def expand_inline_route_blocks(lines : Array(RouteLine)) : Array(RouteLine)
      result = [] of RouteLine
      lines.each do |line|
        if m = line.text.match(INLINE_ROUTE_BLOCK)
          # All three synthesized statements come from the one source line,
          # so they all report it.
          result << line.with_text("#{m[1]} do")
          result << line.with_text(m[2].strip)
          result << line.with_text("end")
        elsif m = line.text.match(INLINE_DEVISE_SCOPE)
          body = (m[1]? || m[2]?).to_s
          result << line.with_text("devise_scope do")
          Noir::TopLevelSplit.split(body, ';', PERMIT_SPLIT).each do |stmt|
            stripped = stmt.strip
            result << line.with_text(stripped) unless stripped.empty?
          end
          result << line.with_text("end")
        else
          result << line
        end
      end
      result
    end

    private def end_line?(line : String) : Bool
      line == "end" || line.starts_with?("end ") || line.starts_with?("end;") || line.starts_with?("end#")
    end

    # Scan the files that declare engine mounts (`config/routes.rb`,
    # `plugin.rb` — discourse pins every plugin's `mount X::Engine, at:`
    # there) and build the engine-constant -> mount-path map. Forms handled:
    #   mount X::Engine, at: "/p"        mount X::Engine => "/p"
    #   Discourse::Application.routes.append { mount X::Engine, at: "/p" }
    private def build_engine_mount_map(files : Array(String)) : Hash(EngineMountKey, String)
      map = Hash(EngineMountKey, String).new
      files.each do |file|
        base = File.basename(file)
        next unless base == "plugin.rb" || base.ends_with?("routes.rb")
        content = ruby_source(file)
        next unless content.includes?("mount")

        content.each_line do |raw|
          line = strip_inline_comment(raw)
          next unless line.includes?("mount")
          if m = line.match(/\bmount\b\s*\(?\s*(?:::)?([A-Z][A-Za-z0-9_:]*)\s*(?:,\s*at:\s*|=>\s*)['"]([^'"]+)['"]/)
            const = m[1]
            key = {configured_base_for(file), const}
            map[key] = normalize_mount_prefix(m[2]) unless map.has_key?(key)
          end
        end
      end
      map
    end

    private def normalize_mount_prefix(at : String) : String
      prefix = at.strip
      return "" if prefix.empty? || prefix == "/"
      prefix = prefix.rchop('/') if prefix.size > 1 && prefix.ends_with?('/')
      prefix.lchop('/')
    end

    # Joins continuation lines into one logical directive, keeping the
    # 1-based line the directive *starts* on — `get "/x",\n  to: "y#z"` is
    # declared on the `get` line, not on the `to:` line that closes it.
    private def logical_route_lines(routes_path : String) : Array(RouteLine)
      lines = [] of RouteLine
      buffer = ""
      buffer_line = 0
      paren_depth = 0
      bracket_depth = 0
      brace_depth = 0

      ruby_source(routes_path).each_line.with_index(1) do |raw_line, line_number|
        stripped = strip_inline_comment(raw_line).strip
        next if stripped.empty?

        if buffer.empty?
          buffer = stripped
          buffer_line = line_number
        else
          buffer = "#{buffer} #{stripped}"
        end
        delta = delimiter_delta(stripped)
        paren_depth += delta[0]
        bracket_depth += delta[1]
        brace_depth += delta[2]

        next if paren_depth > 0 || bracket_depth > 0 || brace_depth > 0
        next if stripped.ends_with?(",")

        lines << RouteLine.new(buffer, buffer_line)
        buffer = ""
        paren_depth = 0
        bracket_depth = 0
        brace_depth = 0
      end

      lines << RouteLine.new(buffer, buffer_line) unless buffer.empty?
      lines
    end

    private def delimiter_delta(line : String) : Tuple(Int32, Int32, Int32)
      paren = 0
      bracket = 0
      brace = 0
      in_str = false
      escaped = false
      quote = '\0'

      line.each_char do |c|
        if in_str
          if escaped
            escaped = false
          elsif c == '\\'
            escaped = true
          elsif c == quote
            in_str = false
          end
          next
        end

        if c == '"' || c == '\''
          in_str = true
          quote = c
          next
        end

        case c
        when '('
          paren += 1
        when ')'
          paren -= 1
        when '['
          bracket += 1
        when ']'
          bracket -= 1
        when '{'
          brace += 1
        when '}'
          brace -= 1
        end
      end

      {paren, bracket, brace}
    end

    private def parse_first_route_name(args : String) : String?
      if m = args.match(/^\s*(?::([A-Za-z_]\w*)|['"]([^'"]+)['"])/)
        return (m[1]? || m[2]?).to_s
      end
      nil
    end

    private def current_custom_route_scope(stack : Array(Frame)) : String?
      if frame = stack.last?
        return frame.kind.to_s if frame.kind == :member || frame.kind == :collection || frame.kind == :new
      end
      nil
    end

    private def custom_resource_action_url(stack : Array(Frame), action : String, route_scope : String?) : String?
      return unless resources_idx = stack.rindex { |f| f.kind == :resources }
      prefix = current_path_prefix(stack[0, resources_idx + 1], route_scope)
      prefix.empty? ? "/#{action}" : "/#{prefix}/#{action}"
    end

    private def current_controller_scope(stack : Array(Frame)) : String?
      stack.reverse_each do |f|
        return f.controller_scope if f.controller_scope
      end
      nil
    end

    private def infer_action_from_path(path : String) : String?
      normalized = path.lchop("/")
      return normalized if normalized.matches?(/\A[A-Za-z_]\w*\z/)
      nil
    end

    private def emit_resource_routes(framework_root : String,
                                     stack : Array(Frame),
                                     kind_kw : String,
                                     name : String,
                                     options : Hash(String, String)) : String?
      singular = (kind_kw == "resource")
      controller_subdir = current_controller_subdir(stack)
      # `module:` on a `resources`/`resource` line nests the controller
      # under an extra namespace directory WITHOUT changing the URL —
      # `resources :accounts, module: :lists` is served by
      # `Lists::AccountsController` (app/controllers/.../lists/accounts_controller.rb).
      # The namespace/scope `module:` is already folded into the stack via
      # `controller_subdir`; the per-line one is not, so apply it here.
      if line_module = options["module"]?
        controller_subdir = controller_subdir.empty? ? line_module : "#{controller_subdir}/#{line_module}"
      end
      ctrl_override = options["controller"]?
      # `resources :users, only: [:index], to: "organizations#users"`: `to:`
      # names the controller and the action every generated route serves.
      to_action : String? = nil
      if (to = options["to"]?) && (m = to.match(/\A([\w\/]+)#(\w+)\z/))
        ctrl_override = m[1]
        to_action = m[2]
      end
      file_base = if ctrl_override
                    # Rails resolves `controller: 'trends/tags'` inside the
                    # namespace module too; only a leading `/` is absolute.
                    # Absolute-style names without the slash still resolve.
                    scoped = controller_subdir.empty? || ctrl_override.starts_with?('/') ? ctrl_override.lchop('/') : "#{controller_subdir}/#{ctrl_override}"
                    ctrl_override.includes?('/') && !controller_file(framework_root, scoped) ? ctrl_override.lchop('/') : scoped
                  else
                    controller_subdir.empty? ? name : "#{controller_subdir}/#{name}"
                  end

      only_list = parse_symbol_list(options["only"]?)
      except_list = parse_symbol_list(options["except"]?)
      url_segment = options["path"]?.try { |p| normalize_route_prefix(p) } || name
      path_prefix = current_path_prefix(stack)
      member_prefix = shallow_nested?(stack, options) ? shallow_path_prefix(stack) : path_prefix

      bases = [file_base]
      unless ctrl_override
        bases << "#{file_base}s" << "#{file_base}es"
        # Irregular y->ies plural: a singular `resource :directory` is backed
        # by `DirectoriesController` (directories_controller.rb), never
        # `directorys`/`directoryes`.
        bases << "#{file_base.rchop('y')}ies" if file_base.ends_with?('y')
      end
      candidates = bases.map { |base| controller_file(framework_root, base) || "#{framework_root}/app/controllers/#{base}_controller.rb" }

      existing_controller_path = candidates.find { |c| known_file?(c) }
      # `only: []` draws no routes of its own (it only nests); an empty list
      # here must not read as "no filter".
      return existing_controller_path if options.has_key?("only") && only_list.empty?
      candidates.each do |ctrl_path|
        # `concat`, not `+=`. `controller_to_endpoint` used to build its
        # return value in `@result` — reassigning it to a fresh array on
        # entry — so this line only worked because Crystal evaluates the
        # `+` receiver before the argument. It now uses a local, which is
        # what makes `concat` safe here.
        @result.concat(controller_to_endpoint(
          ctrl_path, @url, url_segment,
          path_prefix: path_prefix,
          member_prefix: member_prefix,
          only: only_list,
          except: except_list,
          singular: singular,
          member_param: resource_param_name(options, singular),
          to_action: to_action,
        ))
      end

      existing_controller_path
    end

    # Expand a `use_doorkeeper` block into the OAuth routes Doorkeeper
    # mounts. `skip` drops `skip_controllers :group` rows; `controller_map`
    # carries the `controllers group: 'path'` remap so params/callees can
    # still resolve against the app's own controller (Mastodon points
    # `authorizations` at `app/controllers/oauth/authorizations_controller.rb`).
    # Default (un-remapped) groups resolve against `doorkeeper/<group>`,
    # which the host app rarely ships, so they emit the endpoint alone.
    private def emit_doorkeeper_routes(framework_root : String,
                                       stack : Array(Frame),
                                       skip : Set(String),
                                       controller_map : Hash(String, String),
                                       details : Details)
      prefix = current_path_prefix(stack)
      DOORKEEPER_ROUTES.each do |verb, sub, group, action|
        next if skip.includes?(group)

        url = prefix.empty? ? sub : "/#{prefix}#{sub}"
        ctrl_name = controller_map[group]? || "doorkeeper/#{group}"
        ctrl_path = find_controller_file(framework_root, ctrl_name, stack)
        action_params = ctrl_path ? params_for_action(ctrl_path, action, verb) : ([] of Param)
        endpoint = Endpoint.new(url, verb, action_params, details)
        attach_callees_for_action(endpoint, ctrl_path, action)
        endpoint.handler = handler_for_action(ctrl_path, action)
        @result << endpoint
      end
    end

    # Pull the verb list out of a `match ... :via => :get` or
    # `match ... via: [:get, :post]` declaration. Returns the
    # single-element `["ANY"]` when `via:` is missing or empty —
    # modern Rails raises in that case but the older Redmine
    # idiom is permissive.
    private def parse_match_verbs(rest : String) : Array(String)
      parse_route_verbs(rest, ["ANY"])
    end

    private def parse_route_verbs(rest : String, default_verbs : Array(String)) : Array(String)
      via_match = rest.match(/:?via\s*(?:=>|:)\s*(\[[^\]]+\]|%i[\[\(][^\]\)]*[\]\)]|:\w+|['"][A-Za-z_]+['"])/)
      return default_verbs unless via_match
      tail = via_match[1]
      verbs = [] of String
      parse_symbol_list(tail).each do |verb|
        normalized = verb.upcase
        normalized = "ANY" if normalized == "ALL"
        verbs << normalized
      end
      verbs.empty? ? default_verbs : verbs.uniq
    end

    private def strip_inline_comment(line : String) : String
      in_str = false
      escaped = false
      quote = '\0'
      line.each_char_with_index do |c, i|
        if in_str
          if escaped
            escaped = false
          elsif c == '\\'
            escaped = true
          elsif c == quote
            in_str = false
          end
        else
          if c == '"' || c == '\''
            in_str = true
            quote = c
          elsif c == '#'
            return line[0, i]
          end
        end
      end
      line
    end

    private def opens_do_block?(line : String) : Bool
      !!line.match(/\bdo\b\s*(\|[^|]*\|)?\s*\z/)
    end

    # Statement-position `if`/`unless`/`case`/`begin`/`while`/`until`/`for`
    # open a block that a later bare `end` closes. The `end` handler always
    # pops one stack frame, so without crediting these openers a conditional
    # like `if Rails.env.test? ... end` wrapped around routes pops a *real*
    # scope (Spree's `POST /admin/table_columns` leaked out as
    # `/table_columns` once the `if` block above it closed). They carry no
    # path/module of their own, so a transparent `:neutral` frame keeps the
    # surrounding prefix intact for routes inside and restores it after.
    # Modifier forms (`get 'x' if cond`, `redirect_to y unless z`) keep the
    # keyword mid-line, never at the anchored start, so they stay uncounted.
    private def opens_keyword_block?(line : String) : Bool
      return false unless line.matches?(/^(?:if|unless|case|begin|while|until|for)\b/)
      !line.matches?(/\bend\b/)
    end

    # Every path a route with optional segments answers, shortest first:
    # `/top(/:length(/page/:page))` is `/top`, `/top/:length` and
    # `/top/:length/page/:page`. `(.:format)` is dropped, not expanded.
    # Adjacent groups nest the way Journey matches them: `/a(/:b)(/:c)`
    # fills `:b` before `:c`, so it is `/a`, `/a/:b`, `/a/:b/:c`, never
    # `/a/:c`.
    # ponytail: capped at 8 variants; a route with more keeps the first 8.
    private def optional_route_variants(path : String) : Array(String)
      path = path.gsub("(.:format)", "")
      return [path] unless open = path.index('(')
      # A paren inside `#{...}` is Ruby, not an optional segment.
      return [strip_optional_route_segments(path)] if path.includes?("\#{")
      return [strip_optional_route_segments(path)] unless close = group_close(path, open)
      head, inner, tail = path[0, open], path[(open + 1)...close], path[(close + 1)..]
      # Without this group, the groups right after it cannot be filled either.
      rest = tail
      while rest.starts_with?('(') && (next_close = group_close(rest, 0))
        rest = rest[(next_close + 1)..]
      end
      variants = optional_route_variants(head + rest) + optional_route_variants(head + inner + tail)
      variants.map! do |variant|
        variant = variant.gsub(%r{/{2,}}, "/")
        variant.size > 1 && variant.ends_with?('/') ? variant.rchop('/') : variant
      end
      variants.uniq!.first(8)
    end

    # The index of the `)` closing the group opened at `path[open]`.
    private def group_close(path : String, open : Int32) : Int32?
      depth = 0
      (open...path.size).find do |i|
        depth += 1 if path[i] == '('
        depth -= 1 if path[i] == ')'
        depth == 0
      end
    end

    # Rails route strings carry optional segments in parentheses —
    # `(.:format)`, `(/page/:page)`, even nested `(/:length(/page/:page))`.
    # They are DSL syntax, not part of any concrete URL, so emitting
    # `/domain/:id(.:format)` hands a consumer a path that 404s when hit
    # literally. Peel every (possibly nested) optional group down to the
    # required base path, then collapse the `//` and trailing-`/`
    # artifacts the removal can leave behind. Scope prefixes use it; a
    # route path expands through `optional_route_variants`.
    private def strip_optional_route_segments(path : String) : String
      return path unless path.includes?('(')

      result = path
      loop do
        stripped = result.gsub(/\([^()]*\)/, "")
        break if stripped == result
        result = stripped
      end

      result = result.gsub(%r{/{2,}}, "/")
      result = result.rchop('/') if result.size > 1 && result.ends_with?('/')
      result
    end

    private def normalize_route_prefix(path : String) : String
      normalized = strip_optional_route_segments(path).lchop('/')
      normalized = normalized.rchop('/') if normalized.size > 1 && normalized.ends_with?('/')
      normalized
    end

    private def parse_options(line : String) : Hash(String, String)
      result = {} of String => String
      # capture key: "value", key: :symbol, key: [..], key: %i[..], and
      # older hash-rocket forms like :only => [:index].
      line.scan(PARSE_OPTIONS_KEY_VALUE_RE) do |m|
        key = m[1]
        result[key] = normalize_option_value(m[2])
      end
      line.scan(PARSE_OPTIONS_HASHROCKET_RE) do |m|
        key = m[1]
        result[key] = normalize_option_value(m[2])
      end
      result
    end

    private def normalize_option_value(raw : String) : String
      return "" if raw == "nil"
      return raw if raw == "true" || raw == "false"
      if raw.starts_with?('"') || raw.starts_with?('\'')
        raw[1, raw.size - 2]
      elsif raw.starts_with?(':')
        raw[1, raw.size - 1]
      elsif raw.starts_with?("%i") || raw.starts_with?("%w")
        raw[3, raw.size - 4]
      else
        raw[1, raw.size - 2] # strip [ ]
      end
    end

    private def parse_symbol_list(raw : String?) : Array(String)
      return [] of String if raw.nil?
      cleaned = raw.gsub(/%[iw][\[\(]/, "").gsub(/[\[\]\(\)'"]/, "")
      cleaned.split(/[,\s]+/).map(&.strip.lchop(':').strip).reject(&.empty?)
    end

    # `route_scope` (`member`/`collection`/`new`) applies to the innermost
    # `resources` frame. An enclosing one takes the scope of a
    # `member`/`collection`/`new` block opened directly inside it, so
    # `collection do resources :keys end` under `resources :api` is
    # `api/keys`, not `api/:api_id/keys`.
    private def current_path_prefix(stack : Array(Frame), route_scope : String? = nil) : String
      own = stack.rindex { |f| f.kind == :resources }
      parts = [] of String
      stack.each_with_index do |f, i|
        scope = (i == own ? route_scope : nil) || (f.kind == :resources ? enclosed_route_scope(stack, i) : nil)
        # A shallow resource's member and nested routes drop the parents'
        # segments; its collection and `new` routes keep them.
        if f.shallow_member? && scope != "collection" && scope != "new"
          parts = shallow_path_prefix(stack[0, i]).split('/', remove_empty: true)
        end
        path = f.kind == :resources ? resource_frame_path(f, scope) : f.path
        parts << path unless path.empty?
      end
      parts.join("/")
    end

    # The `member`/`collection`/`new` block opened under the `resources`
    # frame at `idx`, before any deeper `resources` frame.
    private def enclosed_route_scope(stack : Array(Frame), idx : Int32) : String?
      (idx + 1...stack.size).each do |j|
        kind = stack[j].kind
        return if kind == :resources
        return kind.to_s if kind == :member || kind == :collection || kind == :new
      end
      nil
    end

    # Rails `shallow`: a resource nested in a shallow scope keeps its
    # collection routes under the parent (`/posts/:post_id/comments`) but
    # serves its member routes without it (`/comments/:id`).
    private def shallow_nested?(stack : Array(Frame), options : Hash(String, String)) : Bool
      return false unless parent_resources_frame(stack)
      options["shallow"]? == "true" || stack.any?(&.shallow?)
    end

    # The path a shallow member route hangs off: every enclosing segment
    # except the resources' own.
    private def shallow_path_prefix(stack : Array(Frame)) : String
      stack.compact_map { |f| f.path unless f.kind == :resources || f.path.empty? }.join("/")
    end

    private def current_controller_subdir(stack : Array(Frame)) : String
      parts = [] of String
      stack.each do |f|
        next if f.controller_subdir.empty?
        parts << f.controller_subdir
      end
      parts.join("/")
    end

    # The RESTful actions `resources` routes, in the order their rows are
    # emitted; `update` answers both PUT and PATCH. `new` and `edit` serve
    # the forms at `/posts/new` and `/posts/:id/edit`.
    RESOURCE_ACTION_VERBS = { {"index", "GET"}, {"show", "GET"}, {"create", "POST"},
                             {"update", "PUT"}, {"update", "PATCH"}, {"destroy", "DELETE"},
                             {"new", "GET"}, {"edit", "GET"} }

    def controller_to_endpoint(
      path : String,
      @url : String,
      resource : String,
      path_prefix : String = "",
      member_prefix : String = path_prefix,
      only : Array(String) = [] of String,
      except : Array(String) = [] of String,
      singular : Bool = false,
      member_param : String? = nil,
      to_action : String? = nil,
    )
      endpoints = [] of Endpoint

      return endpoints unless known_file?(path)

      # `path: ""` / `path: "(:status)"` adds no segment of its own.
      segment = resource.empty? ? "" : "/#{resource}"
      index_url = compose_url(path_prefix, segment).presence || "/"
      member_url = compose_url(member_prefix, member_param ? "#{segment}/:#{member_param}" : segment).presence || "/"
      path_params = url_param_names(index_url)
      member_params = url_param_names(member_url)

      RESOURCE_ACTION_VERBS.each do |route_action, verb|
        next if singular && route_action == "index"
        next unless action_allowed?(route_action, only, except)
        next if @disabled_route_verbs.includes?(verb)
        action = to_action || route_action
        next unless owner = action_owner(path, action)
        on_collection = route_action == "index" || route_action == "create" || route_action == "new"
        params = promote_path_params(action_params(owner, action, verb, path), on_collection ? path_params : member_params)
        details = Details.new(PathInfo.new(owner.path, owner.action_lines[action]?))
        url = on_collection ? index_url : member_url
        url = "#{url.rchop('/')}/#{route_action}" if route_action == "new" || route_action == "edit"
        endpoint = Endpoint.new(url, verb, params, details)
        attach_callees_for_action(endpoint, owner, action)
        endpoint.handler = handler_for_action(owner, action, path)
        endpoints << endpoint
      end

      endpoints
    end

    # Scans a controller file once, collecting per-method params (headers/cookies)
    # plus shared params (params[:x] / params["x"], params.require...permit) and
    # the names of every `def`. Shared because the existing heuristic associates
    # params[:x] with the whole controller, not a specific action. Results are
    # memoized per path so re-resolution (resources + member/collection + `to:`)
    # only reads each controller once.
    private def extract_controller_data(path : String) : ControllerData
      cached = @controller_data_cache[path]?
      return cached if cached

      params_method = Hash(String, Array(Param)).new
      params_body_by_action = Hash(String, Array(Param)).new
      params_query_by_action = Hash(String, Array(Param)).new
      defined_actions = Set(String).new
      helper_calls_by_action = Hash(String, Array(String)).new
      callees_by_action = Hash(String, Array(Noir::RubyCalleeExtractor::Entry)).new
      action_lines = Hash(String, Int32).new
      method_bodies = Hash(String, Array(String)).new
      param_type = "form"

      unless known_file?(path)
        empty = ControllerData.new(path, param_type, params_method, params_body_by_action, params_query_by_action,
          defined_actions, helper_calls_by_action, callees_by_action, action_lines)
        @controller_data_cache[path] = empty
        return empty
      end

      controller_content = ruby_source(path)
      param_type = "json" if controller_content.includes?("render json:")
      callees_by_action = extract_action_callees(controller_content, path) if callees_needed?

      this_method = ""
      # `params.require(:article).permit(...)` roots, and the reads that use
      # a key as a hash (`params[:article].is_a?(Hash)`, `&.key?(:x)`): such a
      # read of a permit root is the list's container, whose fields the list
      # already names. A plain `params[:page]` read stays a field.
      permit_roots = Set(String).new
      container_reads = Set({String, String}).new
      plain_reads = Set({String, String}).new
      permit_buf : String? = nil
      permit_mask = ""
      permit_lines = 0

      controller_lines = controller_content.lines
      class_body = own_class_body(controller_lines)
      # Subscript reads wrapped over lines (`request.headers[` / `"X-Key"` /
      # `]`) are read off this folded view; see the `'['` scans below.
      folded_lines = Noir::CallFold.fold(controller_lines) { |l| strip_inline_comment(l) }

      controller_lines.each_with_index do |raw_line, index|
        line = strip_inline_comment(raw_line)

        if line.includes?("def ")
          func_name = line.split("def ", 2)[1].split("(")[0].split(";")[0].strip
          func_name = func_name.lchop("self.").strip
          unless func_name.empty?
            this_method = func_name
            # An unclosed `permit(` must not swallow the next action's permits.
            permit_buf = nil
            defined_actions << func_name
            action_lines[func_name] = index + 1
            method_bodies[this_method] ||= [] of String
          end
        end

        unless this_method.empty?
          method_bodies[this_method] ||= [] of String
          method_bodies[this_method] << line
        end

        # `permit(...)` may wrap across lines, so collect lines until its parens
        # balance (bounded: an unbalanced `permit(` must not swallow the file).
        # Parens and the `permit(` itself are found on a quote-blanked twin of
        # the buffer, so `"calling permit( now"` neither opens nor closes it.
        if buf = permit_buf
          permit_buf = "#{buf} #{line}"
          permit_mask = "#{permit_mask} #{blank_quoted(line)}"
          permit_lines += 1
        elsif (line.includes?("permit") || line.includes?("expect")) && (opener = permit_opener(line, controller_lines, index)) &&
              (masked = blank_quoted(opener)).matches?(PERMIT_OPEN)
          permit_buf = opener
          permit_mask = masked
          permit_lines = 1
        end
        if buf = permit_buf
          if args = permit_args(buf, permit_mask)
            permit_buf = nil
            scope = PermitScope.new(method_bodies[this_method]? || [] of String, class_body)
            names = permit_mask.match(PERMIT_OPEN).try(&.[0].includes?("expect")) ? expect_names(args, scope) : permit_names(args, scope)
            if !names.empty? && (root = permit_mask.match(/params\.require\s*\(\s*:(\w+)/))
              permit_roots << root[1]
            end
            names.each do |name|
              next if this_method.empty?
              params_body_by_action[this_method] ||= [] of Param
              params_body_by_action[this_method] << Param.new(name, "", param_type)
              params_query_by_action[this_method] ||= [] of Param
              params_query_by_action[this_method] << Param.new(name, "", "query")
            end
          elsif permit_lines >= PERMIT_MAX_LINES
            permit_buf = nil
          end
        end

        if !this_method.empty? && line.includes?("permitted_attributes") && (pm = line.match(PUNDIT_PERMITTED))
          pundit_permitted_names(path, pm[1], this_method).each do |name|
            params_body_by_action[this_method] ||= [] of Param
            params_body_by_action[this_method] << Param.new(name, "", param_type)
            params_query_by_action[this_method] ||= [] of Param
            params_query_by_action[this_method] << Param.new(name, "", "query")
          end
        end

        # Every param source below is a `[ ... ]` subscript or a
        # `params.fetch(` / `params.dig(` / `headers.fetch(` call (on bare
        # `params` only: `sign_in_params[:x]` / `source_params.fetch(:x)` read
        # a nested key). A line with none cannot match any of them, so skip
        # the regex ops — this runs on every line of every controller in the app.
        line = folded_lines[index]
        # The http_accept_language gem's controller helper parses the
        # `Accept-Language` header.
        if !this_method.empty? && line.includes?("http_accept_language") && line.matches?(/(?<![\w.@:])http_accept_language\b/)
          params_method[this_method] ||= [] of Param
          params_method[this_method] << Param.new("Accept-Language", "", "header")
        end
        if line.includes?('[') || line.includes?("params.") || line.includes?("headers.")
          line.scan(/(?<![\w.])params(?:\[|\.(?:fetch|dig|require)\s*\()\s*(?::(\w+)|['"]([^'"]+)['"])\s*[\],)]/) do |m|
            name = (m[1]? || m[2]?).to_s.strip
            # `params[:user][:password]` reads `password` (the leaf, as a
            # permit list names it); `params.require(:post).permit(...)` is
            # the permit list's, and `params.require(:url)` alone reads `url`.
            tail = line[m.end..]
            if m[0].includes?("require")
              chained = tail.strip.empty? ? controller_lines[index + 1]?.to_s : tail
              next if chained.matches?(/\A\s*\.\s*(?:permit|expect|fetch|dig)\b/)
            end
            while nested = tail.match(/\A\s*\[\s*(?::(\w+)|['"]([^'"]+)['"])\s*\]/)
              name = (nested[1]? || nested[2]?).to_s
              tail = tail[nested.end..]
            end
            # `params.dig(:page, :slug_suffix)` reads the leaf too.
            if m[0].includes?("dig") && m[0].ends_with?(',')
              while nested = tail.match(/\A\s*(?::(\w+)|['"]([^'"]+)['"])\s*([,)])/)
                name = (nested[1]? || nested[2]?).to_s
                tail = tail[nested.end..]
                break if nested[3] == ")"
              end
            end
            # `params[:controller]` / `params[:action]` are the router's own keys.
            next if name.empty? || this_method.empty? || name == "controller" || name == "action"
            (tail.matches?(CONTAINER_USE) ? container_reads : plain_reads) << {this_method, name}
            params_body_by_action[this_method] ||= [] of Param
            params_body_by_action[this_method] << Param.new(name, "", param_type)
            params_query_by_action[this_method] ||= [] of Param
            params_query_by_action[this_method] << Param.new(name, "", "query")
          end

          # `request.headers["X-Key"]`, `request.headers.fetch("X-Key")`, and
          # the Rack spelling `request.env["HTTP_X_KEY"]` (named `X-Key`),
          # which `request.headers["HTTP_X_KEY"]` also accepts.
          line.scan(/request\.(?:headers(?:\[|\.fetch\s*\()\s*['"](?:HTTP_(\w+)|([^'"]+))['"]|env\[\s*['"]HTTP_(\w+)['"]\s*\])/) do |hm|
            # `HTTP_VERSION` is the server's protocol variable, not a header;
            # `CONTENT_TYPE` / `CONTENT_LENGTH` are the CGI spellings of theirs.
            next if hm[1]? == "VERSION" || hm[3]? == "VERSION"
            raw = hm[2]?
            raw = raw.split('_').join('-', &.capitalize) if raw && raw.in?("CONTENT_TYPE", "CONTENT_LENGTH")
            name = (raw || (hm[1]? || hm[3]).split('_').join('-', &.capitalize)).strip
            next if name.empty? || this_method.empty?
            params_method[this_method] ||= [] of Param
            params_method[this_method] << Param.new(name, "", "header")
          end

          line.scan(/cookies(?:\.(?:signed|encrypted))?\[\s*(?::(\w+)|['"]([^'"]+)['"])\s*\]/) do |cm|
            name = (cm[1]? || cm[2]?).to_s.strip
            next if name.empty? || this_method.empty?
            params_method[this_method] ||= [] of Param
            params_method[this_method] << Param.new(name, "", "cookie")
          end
        end
      end

      unless permit_roots.empty?
        {params_body_by_action, params_query_by_action}.each do |by_action|
          by_action.each do |method, list|
            list.reject! do |param|
              permit_roots.includes?(param.name) && container_reads.includes?({method, param.name}) && !plain_reads.includes?({method, param.name})
            end
          end
        end
      end

      helper_keys_by_action = Hash(String, Hash(String, Set(String))).new
      helper_calls_by_action = build_helper_call_map(method_bodies, defined_actions, helper_keys_by_action)

      data = ControllerData.new(path, param_type, params_method, params_body_by_action, params_query_by_action,
        defined_actions, helper_calls_by_action, callees_by_action, action_lines, helper_keys_by_action)
      @controller_data_cache[path] = data
      data
    end

    # The line a permit list opens on, with the `params.require(:post)` a
    # chained `.permit(` on its own line continues.
    private def permit_opener(line : String, lines : Array(String), index : Int32) : String
      return line unless index > 0 && line.matches?(/\A\s*\.\s*(?:permit|expect)\s*\(/)
      previous = strip_inline_comment(lines[index - 1]).strip
      previous.matches?(/(?<![\w.])params(?:\.(?:require|fetch)\s*\([^)]*\))?\z/) ? "#{previous}#{line.lstrip}" : line
    end

    PERMIT_MAX_LINES = 200
    PERMIT_SPLIT     = Noir::TopLevelSplit::Rules.new
    # `params.permit(`, `params.require(...).permit(`, `params.fetch(...).permit(`,
    # or Rails 8's `params.expect(` (anchored to bare `params`).
    PERMIT_OPEN = /(?<![\w.])params\.(?:expect\s*\(|(?:(?:require|fetch)\s*\([^)]*\)\s*\.)?permit\s*\()|(?<![\w.])permit\s*\(/

    # Text between the parens of the first `permit(` / `params.expect(`, or nil
    # while unbalanced. `mask` is `text` with string literals blanked (see
    # `blank_quoted`); the parens are counted on it and the result is sliced
    # from `text`.
    private def permit_args(text : String, mask : String) : String?
      return unless m = mask.match(PERMIT_OPEN)
      open = m.byte_end(0)
      depth = 0
      mask.to_slice[open..].each_with_index do |b, i|
        depth += 1 if b == '('.ord
        if b == ')'.ord
          return text.byte_slice(open, i) if depth == 0
          depth -= 1
        end
      end
      nil
    end

    # `line` with the inside of '...' / "..." literals blanked byte-for-byte,
    # so byte offsets still line up with `line`.
    private def blank_quoted(line : String) : String
      return line unless line.includes?('"') || line.includes?('\'')
      bytes = line.to_slice.dup
      quote = 0_u8
      escaped = false
      bytes.each_with_index do |b, i|
        if quote == 0
          quote = b if b == '"'.ord || b == '\''.ord
          next
        end
        if escaped
          escaped = false
        elsif b == '\\'.ord
          escaped = true
        elsif b == quote
          quote = 0_u8
          next
        end
        bytes[i] = ' '.ord.to_u8
      end
      String.new(bytes)
    end

    # A read that treats the value as a hash rather than a field.
    # `is_a?(String)` asks whether the value is a scalar, which is a field.
    CONTAINER_USE = /\A\s*&?\.\s*(?:(?:is_a\?|kind_of\?|instance_of\?)\s*\(?\s*(?:Hash|ActionController::Parameters|Array)\b|key\?|has_key\?|keys\b|each\b|to_unsafe_h\b|to_h\b|slice\b|except\b)/

    # `lines` with the bodies of classes and modules nested in the file's
    # first class blanked: a `class Serializer` inside a controller holds
    # its own `ALLOWED` and `def permitted`, which the controller's bare
    # `permitted` never names.
    private def own_class_body(lines : Array(String)) : Array(String)
      return lines unless first = lines.index(&.matches?(/\A\s*class\s/))
      outer = lines[first].size - lines[first].lstrip.size
      nested : Int32? = nil
      lines.map_with_index do |line, idx|
        indent = line.size - line.lstrip.size
        if open = nested
          nested = nil if indent == open && line.strip == "end"
          next ""
        end
        if idx > first && indent > outer && line.matches?(/\A\s*(?:class|module)\s+[A-Z]/) && !line.matches?(/\bend\s*\z/)
          nested = indent
          next ""
        end
        line
      end
    end

    # Pundit's `permitted_attributes(@comment)` / `permitted_attributes(Comment)`.
    PUNDIT_PERMITTED = /(?<![\w.])permitted_attributes\s*\(\s*(@\w+|[A-Z][\w:]*)\s*[,)]/

    # The keys Pundit's `permitted_attributes(record)` permits in `action`:
    # the record's policy's `permitted_attributes_for_<action>`, else its
    # `permitted_attributes` (`app/policies/comment_policy.rb`).
    # ponytail: the action is the method the call sits in, and the policy is
    # found by convention; a policy that inherits the list yields nothing.
    private def pundit_permitted_names(controller_path : String, record : String, action : String) : Array(String)
      return [] of String unless idx = controller_path.rindex("/app/controllers/")
      policy = "#{controller_path[0, idx]}/app/policies/#{record.lchop('@').camelcase.underscore.gsub("::", "/")}_policy.rb"
      return [] of String unless known_file?(policy)
      scope = PermitScope.new([] of String, ruby_source(policy).lines)
      names = permit_list_names("permitted_attributes_for_#{action}", scope, 0)
      names.empty? ? permit_list_names("permitted_attributes", scope, 0) : names
    end

    # Where a permit list's bare names are looked up: the lines of its method
    # so far (a local list) and the whole controller file (a constant or a
    # method that returns one).
    private record PermitScope, body : Array(String), file : Array(String)

    # Param names from a permit argument list: the leading key of each
    # top-level entry (`:title`, `"title"`, `tags: []`, `a: {b: 1}`, `:a => []`,
    # `{ tags: [] }`). A bare name (`permit(allowed_params)`, `*BASE`,
    # `ALLOWED`) is a local, constant or method holding the list, read from
    # `scope`; one that resolves to no list literal yields nothing.
    private def permit_names(args : String, scope : PermitScope? = nil, depth : Int32 = 0) : Array(String)
      names = [] of String
      Noir::TopLevelSplit.split(args, ',', PERMIT_SPLIT).each do |entry|
        entry = entry.strip
        if entry.starts_with?('{') && entry.ends_with?('}')
          names.concat(permit_names(entry[1...-1], scope, depth))
        elsif m = entry.match(/\A\*?([A-Za-z_]\w*)\z/)
          names.concat(permit_list_names(m[1], scope, depth)) if scope
        elsif m = entry.match(/\A:?(?:"([a-z_][a-z0-9_]*)"|'([a-z_][a-z0-9_]*)'|([a-z_][a-z0-9_]*))\s*(?::(?!:)|=>|\z)/)
          names << (m[1]? || m[2]? || m[3]).to_s
        elsif m = entry.match(/\?\s*:([a-z_]\w*)\s*:\s*(?::([a-z_]\w*)|nil)\s*\z/)
          # `@user.admin? ? :role : nil`: a key permitted for some callers.
          names << m[1]
          names << m[2] if m[2]?
        end
      end
      names
    end

    # Param names from a `params.expect(...)` argument list. `product: [ :name ]`
    # (and the array-of-hashes form `comments: [[ :body ]]`) names the root key
    # whose inner list holds the fields, so the fields are the params; a bare
    # `:id` / `tags: []` is a param itself.
    private def expect_names(args : String, scope : PermitScope? = nil) : Array(String)
      names = [] of String
      Noir::TopLevelSplit.split(args, ',', PERMIT_SPLIT).each do |entry|
        if (m = entry.match(/\A:?["']?[a-z_][a-z0-9_]*["']?\s*(?::(?!:)|=>)\s*\[(.*)\]\s*\z/m)) &&
           !(inner = m[1].strip.lchop('[').rchop(']').strip).empty?
          names.concat(permit_names(inner, scope))
        else
          names.concat(permit_names(entry, scope))
        end
      end
      names
    end

    # The keys the list `name` holds: a local assigned earlier in the method
    # (with what `<<` / `push` / `concat` / `+=` add to it later, under any
    # condition — a key permitted for some callers), else a constant or a
    # method of the controller file.
    # ponytail: one file; a list built in a concern or parent class stays
    # unresolved and yields nothing.
    private def permit_list_names(name : String, scope : PermitScope, depth : Int32) : Array(String)
      return [] of String if depth > 3
      names = [] of String
      assign = /\A\s*#{Regex.escape(name)}\s*=(?![=~>])\s*(.*)\z/
      if name[0].ascii_lowercase? && (idx = scope.body.rindex(&.matches?(assign)))
        names.concat(list_literal_names(statement_from(scope.body, idx, assign), scope, depth + 1))
        append = /\A\s*#{Regex.escape(name)}\s*(?:<<|\+=|\.(?:push|concat|append)\b\s*\(?)\s*(.+)\z/
        ((idx + 1)...scope.body.size).each do |i|
          next unless m = scope.body[i].match(append)
          item = m[1].sub(/\s+(?:if|unless)\s+.*\z/, "").strip
          item = item.rchop(')') if item.count('(') < item.count(')')
          names.concat(list_literal_names(item.starts_with?('[') || item.starts_with?('%') ? item : "[#{item}]", scope, depth + 1))
        end
      elsif name[0].ascii_uppercase? && (idx = scope.file.index(&.matches?(assign)))
        names.concat(list_literal_names(statement_from(scope.file, idx, assign), scope, depth + 1))
      elsif idx = scope.file.index(&.matches?(/\A\s*def\s+(?:self\.)?#{Regex.escape(name)}\s*(?:\(\s*\))?\s*\z/))
        # A method's value is its last statement: from the last body line at
        # the body's own indent to its end.
        indent = scope.file[idx].size - scope.file[idx].lstrip.size
        body = scope.file[(idx + 1)..].take_while { |l| l.strip.empty? || l.size - l.lstrip.size > indent }
          .map { |l| strip_inline_comment(l) }.reject(&.strip.empty?)
        unless body.empty?
          base = body.min_of { |l| l.size - l.lstrip.size }
          start = body.rindex { |l| l.size - l.lstrip.size == base && !l.lstrip.matches?(/\A[\])}]/) } || 0
          if body[start].strip == "end"
            # An `if`/`case` ends it: each branch's list is a value it returns.
            body.each do |l|
              names.concat(list_literal_names(l, PermitScope.new(body, scope.file), depth + 1)) if l.lstrip.matches?(/\A(?:\[|%[iwIW][\[(])/)
            end
          else
            names.concat(list_literal_names(body[start..].join(" "), PermitScope.new(body, scope.file), depth + 1))
          end
        end
      end
      names
    end

    # The value of the assignment at `lines[idx]`, joined over the lines its
    # brackets stay open on.
    private def statement_from(lines : Array(String), idx : Int32, assign : Regex) : String
      text = strip_inline_comment(lines[idx]).match(assign).try(&.[1]).to_s
      j = idx + 1
      while text.count("[({") > text.count("])}") && j < lines.size && j - idx < 100
        text = "#{text} #{strip_inline_comment(lines[j])}"
        j += 1
      end
      text
    end

    # The keys a list expression names: `[:a, { tags: [] }, *BASE]`,
    # `%i[a b]`, `BASE + %i[c]`, a bare constant or local; `.freeze` and
    # friends dropped.
    private def list_literal_names(text : String, scope : PermitScope, depth : Int32) : Array(String)
      text = text.strip.sub(/(?:\.(?:freeze|dup|uniq|compact|flatten)\b)+\s*\z/, "").strip
      names = [] of String
      parts = Noir::TopLevelSplit.split(text, '+', PERMIT_SPLIT)
      if parts.size > 1
        parts.each { |part| names.concat(list_literal_names(part, scope, depth)) }
      elsif m = text.match(/\A%[iwIW][\[(](.*)[\])]\z/m)
        names.concat(m[1].split.select(&.matches?(/\A[a-z_]\w*\z/)))
      elsif text.starts_with?('[') && text.ends_with?(']')
        names.concat(permit_names(text[1...-1], scope, depth))
      elsif text.matches?(/\A[A-Za-z_]\w*\z/)
        names.concat(permit_list_names(text, scope, depth))
      end
      names
    end

    private def extract_action_callees(content : String, path : String) : Hash(String, Array(Noir::RubyCalleeExtractor::Entry))
      result = Hash(String, Array(Noir::RubyCalleeExtractor::Entry)).new
      lines = content.lines
      index = 0

      while index < lines.size
        stripped = strip_inline_comment(lines[index]).strip
        if m = stripped.match(/^(?:private\s+|protected\s+|public\s+)?def\s+(?:self\.)?([A-Za-z_]\w*[!?=]?)(?!\w)/)
          action = m[1]
          inline_body, closed_on_def_line = inline_def_body(stripped, m[0])
          body_lines = [] of String
          body_start_line = inline_body ? index + 1 : index + 2
          body_lines << inline_body if inline_body

          unless closed_on_def_line
            depth = 1
            index += 1

            while index < lines.size
              raw_body_line = lines[index]
              body_line = strip_inline_comment(raw_body_line).strip

              if ruby_closes_block?(body_line)
                depth -= 1
                break if depth == 0
                body_lines << raw_body_line
                index += 1
                next
              end

              body_lines << raw_body_line
              depth += ruby_block_open_delta(body_line)
              index += 1
            end
          end

          callees = Noir::RubyCalleeExtractor.callees_for_body(body_lines.join("\n"), path, body_start_line)
          result[action] = callees unless callees.empty?
        end

        index += 1
      end

      result
    end

    private def inline_def_body(line : String, match_text : String) : Tuple(String?, Bool)
      return {nil, false} if match_text.size >= line.size

      tail = line[match_text.size, line.size - match_text.size].strip
      return {nil, false} unless tail.starts_with?(";")

      tail = tail[1, tail.size - 1].strip
      if m = tail.match(/^(.*?)(?:;\s*)?end\b/)
        body = m[1].strip
        return {body.empty? ? nil : body, true}
      end

      {tail.empty? ? nil : tail, false}
    end

    private def ruby_block_open_delta(line : String) : Int32
      return 0 if line.empty?
      return 1 if line.match(/\bdo\b\s*(\|[^|]*\|)?\s*\z/)
      return 1 if line.match(/^(if|unless|case|begin|while|until|for|class|module|def)\b/) && !line.match(/\bend\b/)
      0
    end

    private def dedup_by_name(params : Array(Param)) : Array(Param)
      seen = Set(String).new
      params.each_with_object([] of Param) do |p, acc|
        next unless seen.add?(p.name)
        acc << p
      end
    end

    # Build params for a custom action (member/collection or explicit
    # controller#action). Mirrors the resources flow: per-action headers/cookies
    # plus the action-local body/query params for the verb.
    private def params_for_action(controller_path : String?, action : String, verb : String) : Array(Param)
      return [] of Param unless controller_path && (owner = action_owner(controller_path, action))

      action_params(owner, action, verb, controller_path)
    end

    # `data` is the file holding `action`'s `def`; `controller_path` is the
    # routed controller, whose callback chain runs ahead of it.
    private def action_params(data : ControllerData, action : String, verb : String,
                              controller_path : String = data.path) : Array(Param)
      result = [] of Param
      each_helper(data, action) { |name, keys| merge_action_params(result, data, name, verb, keys) }
      merge_callback_params(result, controller_path, action, verb)

      result
    end

    # `name`, then the methods of its file it calls, transitively and each
    # once (`create` -> `send_instructions` -> `redirect_url_param`), with
    # the keys a caller narrowed a helper to: `profile_params[:account_id]`
    # uses one field of the permit list, not all of them. nil = used whole,
    # which one caller reading it whole is enough for.
    private def each_helper(data : ControllerData, name : String, & : String, Set(String)? ->)
      order = [name]
      keys = {name => nil.as(Set(String)?)}
      index = 0
      while index < order.size
        current = order[index]
        index += 1
        data.helper_calls_by_action[current]?.try &.each do |helper|
          narrowed = data.helper_keys_by_action[current]?.try(&.[helper]?) || keys[current]
          if keys.has_key?(helper)
            old = keys[helper]
            keys[helper] = old && narrowed ? old | narrowed : nil
          else
            order << helper
            keys[helper] = narrowed
          end
        end
      end
      order.each { |helper| yield helper, keys[helper] }
    end

    # The controller data holding `action`'s `def`: the routed controller's
    # own, else the nearest ancestor class or included concern that defines
    # it, the way Ruby looks the method up (`Api::V2::AccountsController <
    # Api::V1::AccountsController` routes the parent's `index`). nil when no
    # file along the chain defines it.
    private def action_owner(controller_path : String, action : String) : ControllerData?
      data = extract_controller_data(controller_path)
      return data if data.defined_actions.includes?(action)
      return unless leaf = callback_chain.controller_in(controller_path)
      callback_chain.resolve(leaf, nil).paths.each do |path|
        owner = extract_controller_data(path)
        return owner if owner.defined_actions.includes?(action)
      end
      nil
    end

    # The param reads in the `before_action` callbacks that run ahead of
    # `action`: its controller's own, its ancestors' and their concerns',
    # less what `skip_before_action` / `only:` / `except:` drop for it.
    # ApplicationController's token check reads `Authorization` for every
    # action of the app. A callback's `def` is looked up nearest first along
    # the chain, as Ruby does. Its `params[:x]` reads carry
    # `CALLBACK_PARAM_TAG` until `drop_foreign_segment_params` has seen the
    # whole route table.
    private def merge_callback_params(result : Array(Param), path : String, action : String, verb : String)
      chain = callback_chain
      return unless leaf = chain.controller_in(path)
      resolved = chain.resolve(leaf, action)
      resolved.callbacks.each do |callback|
        next unless file = resolved.paths.find { |p| extract_controller_data(p).defined_actions.includes?(callback) }
        data = extract_controller_data(file)
        each_helper(data, callback) do |name, keys|
          data.params_method[name]?.try &.each { |p| push_unique_param(result, clone_param(p)) }
          request_params(data, name, verb, keys).each do |param|
            next if result.any? { |existing| existing.name == param.name && existing.param_type == param.param_type }
            param = clone_param(param)
            param.tags << CALLBACK_PARAM_TAG
            result << param
          end
        end
      end
    end

    CALLBACK_PARAM_TAG = Tag.new("rails_callback_param", "", "rails")

    # A callback shared by a controller's routes reads every route's URL
    # keys: `set_contact` reads `params[:contact_id]`, a segment of the
    # nested routes and absent from the rest, where it is no client field.
    # So a callback read named like a path key of some route, but not of
    # this one, is dropped; the rest stay and lose their marker.
    private def drop_foreign_segment_params
      segments = Set(String).new
      @result.each { |endpoint| segments.concat(url_param_names(endpoint.url)) }
      @result.each_with_index do |endpoint, index|
        next unless endpoint.params.any?(&.tags.includes?(CALLBACK_PARAM_TAG))
        endpoint.params = endpoint.params.compact_map do |param|
          next param unless param.tags.includes?(CALLBACK_PARAM_TAG)
          next if param.param_type != "path" && segments.includes?(param.name)
          param.tags = param.tags - [CALLBACK_PARAM_TAG]
          param
        end
        @result[index] = endpoint
      end
    end

    # Every class and module under a `controllers` directory of the scan.
    private def callback_chain : Noir::RailsCallbackChain
      @callback_chain ||= Noir::RailsCallbackChain.new.tap do |chain|
        @known_files.each do |path|
          next unless path.ends_with?(".rb") && base_relative_path(path).includes?("controllers")
          chain.add_file(path, ruby_source(path).lines)
        end
      end
    end

    private def merge_action_params(result : Array(Param), data : ControllerData, action : String, verb : String,
                                    keys : Set(String)? = nil)
      data.params_method[action]?.try &.each { |p| push_unique_param(result, clone_param(p)) }
      request_params(data, action, verb, keys).each do |param|
        push_unique_param(result, clone_param(param))
      end
    end

    # The `params` reads of method `name`, typed by the verb, limited to
    # `keys` when its caller only reads those. Keys that name none of them
    # index into something else (`filters[:status]` of a
    # `params.fetch(:filter, {})`), so they leave the reads whole.
    private def request_params(data : ControllerData, name : String, verb : String, keys : Set(String)?) : Array(Param)
      source = case verb
               when "GET", "HEAD", "OPTIONS", "DELETE"
                 data.params_query_by_action[name]?
               else
                 data.params_body_by_action[name]?
               end
      params = dedup_by_name(source || [] of Param)
      return params unless keys
      narrowed = params.select { |p| keys.includes?(p.name) }
      narrowed.empty? ? params : narrowed
    end

    private def push_unique_param(params : Array(Param), param : Param)
      params << param unless params.any? { |existing| existing.name == param.name && existing.param_type == param.param_type }
    end

    # Retypes, in place, the params the route's URL binds (`id`, `slug`,
    # `article_slug`, ...) from the query/body type the controller scan
    # guessed to `path`.
    private def promote_path_params(params : Array(Param), names : Array(String)) : Array(Param)
      return params if names.empty?
      params.each_index do |index|
        next unless names.includes?(params[index].name)
        param = params[index]
        param.param_type = "path"
        params[index] = param
      end
      params
    end

    private def clone_param(param : Param) : Param
      Param.new(param.name, param.value, param.param_type)
    end

    private def build_helper_call_map(method_bodies : Hash(String, Array(String)), defined_actions : Set(String),
                                      helper_keys : Hash(String, Hash(String, Set(String)))) : Hash(String, Array(String))
      helper_calls = Hash(String, Array(String)).new

      # Tokenize each method body once into the set of identifiers it
      # references, then test action names by set membership. The previous
      # shape compiled an interpolated `/\b#{candidate}\b/` and rescanned
      # the whole body for every (method × action) pair — O(M·A) recompiled
      # regexes per controller, quadratic in the action count. Whole-token
      # set membership is equivalent to the `\b…\b` word-boundary match for
      # identifier names. Testing every action against every body was
      # still O(M·A) set lookups — 256M for a 16k-action controller — so
      # look the body's tokens up among the actions instead, and put the
      # matches back in action order (it is the params' order).
      action_order = Hash(String, Int32).new
      defined_actions.each_with_index { |action, index| action_order[action] = index }
      method_bodies.each do |method_name, body_lines|
        matches = Set(String).new
        keys = Hash(String, Set(String)).new
        whole = Set(String).new
        body_lines.each do |line|
          # `render :show` / `render "posts/show"` name a view, not a call,
          # so symbol and string tokens must not pull `show`'s params in.
          blank_quoted(line).scan(HELPER_TOKEN) do |m|
            token = m[1]
            next unless token != method_name && action_order.has_key?(token)
            matches << token
            if key = m[2]?
              (keys[token] ||= Set(String).new) << key
            else
              whole << token
            end
          end
        end
        whole.each { |token| keys.delete(token) }
        helper_keys[method_name] = keys unless keys.empty?
        helper_calls[method_name] = matches.to_a.sort_by! { |action| action_order[action] } unless matches.empty?
      end

      helper_calls
    end

    # A call to a method of this controller: a bare or `self.` identifier,
    # never `@ivar` (`@note` is not the `note` callback) or a method on
    # another receiver (`@contact.notes`). A trailing `[:key]` is captured:
    # `profile_params[:account_id]` reads one field of what the helper
    # permits.
    HELPER_TOKEN = /(?:(?<=self\.)|(?<![:\w@.]))([A-Za-z_]\w*[!?=]?)(?:\s*\[\s*:(\w+)\s*\])?/

    # `articles#show` at the action's `def` line — in the routed controller,
    # or in the ancestor it inherits the action from — the file an agent
    # opens after the route. nil when the controller file was not found; the
    # line is nil when no file along the chain defines the action.
    private def handler_for_action(controller_path : String?, action : String) : Handler?
      return if controller_path.nil?
      data = action_owner(controller_path, action) || extract_controller_data(controller_path)
      handler_for_action(data, action, controller_path)
    end

    private def handler_for_action(data : ControllerData, action : String, controller_path : String) : Handler
      controller = File.basename(controller_path, ".rb").rchop("_controller")
      handler = Handler.new("#{controller}##{action}", data.path, data.action_lines[action]?)
      handler.dispatch_path = controller_path unless controller_path == data.path
      handler
    end

    private def attach_callees_for_action(endpoint : Endpoint, controller_path : String?, action : String)
      return if controller_path.nil?
      data = action_owner(controller_path, action) || extract_controller_data(controller_path)
      attach_callees_for_action(endpoint, data, action)
    end

    private def attach_callees_for_action(endpoint : Endpoint, data : ControllerData, action : String)
      return unless callees_needed?
      if callees = data.callees_by_action[action]?
        attach_ruby_callees(endpoint, callees)
      end
    end

    private def parent_resources_frame(stack : Array(Frame)) : Frame?
      stack.reverse_each do |f|
        return f if f.kind == :resources
      end
      nil
    end

    # Parses `=> "ctrl#action"`, `to: "ctrl#action"`,
    # `controller: "ctrl", action: :show`, and controller-block
    # `get "path" => :action` forms.
    private def parse_controller_action(rest : String, scoped_controller : String? = nil) : Tuple(String, String)?
      # Ruby method names may end in `?`/`!` (`to: 'requests#merged?'`).
      if m = rest.match(/=>\s*['"]([^'"#]+)#(\w+[?!]?)['"]/)
        return {m[1], m[2]}
      end
      if m = rest.match(/to:\s*['"]([^'"#]+)#(\w+[?!]?)['"]/)
        return {m[1], m[2]}
      end
      options = parse_options(rest)
      if controller = options["controller"]?
        if action = options["action"]?
          return {controller, action}
        end
      end
      if scoped_controller
        if action = options["action"]?
          return {scoped_controller, action}
        end
        if m = rest.match(/(?:=>|to:)\s*:(\w+[?!]?)/)
          return {scoped_controller, m[1]}
        end
      end
      nil
    end

    private def controller_action_for_symbol_route(rest : String, fallback : String) : String
      parse_options(rest)["action"]? || fallback
    end

    # Rails allows compact declarations such as `post "stories/preview"`
    # which route to `StoriesController#preview`. These still need controller
    # resolution so params/callees/AI context attach to the emitted endpoint.
    private def infer_implicit_controller_action(path : String, rest : String,
                                                 scoped_controller : String? = nil) : Tuple(String, String)?
      return if explicit_route_destination?(rest)

      segments = static_route_segments(path)
      return if segments.empty?

      if scoped_controller
        action = segments.last
        return unless valid_action_name?(action)
        return {scoped_controller, action}
      end

      return if segments.size < 2
      action = segments.last
      return unless valid_action_name?(action)

      {segments[0, segments.size - 1].join("/"), action}
    end

    private def explicit_route_destination?(rest : String) : Bool
      !!rest.match(/^\s*['"][^'"]+['"]\s*=>/) ||
        !!rest.match(/\bto\s*:/) ||
        !!rest.match(/:?to\s*=>/) ||
        !!rest.match(/:?controller\s*(?:=>|:)/) ||
        !!rest.match(/:?action\s*(?:=>|:)/)
    end

    private def static_route_segments(path : String) : Array(String)
      path.lchop('/').split('/').map do |segment|
        segment = segment.split('.', 2)[0]
        return [] of String if segment.empty?
        return [] of String if segment.includes?(':') || segment.includes?('*')
        return [] of String if segment.includes?('(') || segment.includes?(')')
        segment
      end
    end

    private def valid_action_name?(name : String) : Bool
      !!name.match(/\A[A-Za-z_]\w*[!?=]?\z/)
    end

    # Resolve `ctrl#action` to a controller file. When the route lives inside a
    # `namespace :admin` block, Rails resolves "monitor#ping" to
    # `Admin::MonitorController` — try the subdir-prefixed path first, then fall
    # back to a bare lookup so absolute-style references ("api/v1/users") still
    # work regardless of where they're declared.
    private def find_controller_file(framework_root : String, ctrl_name : String,
                                     stack : Array(Frame) = [] of Frame) : String?
      return if ctrl_name.empty?
      subdir = current_controller_subdir(stack)
      # Rails prefixes the scope module onto `a/b#x` too; only a leading
      # `/` makes the controller absolute.
      if !subdir.empty? && !ctrl_name.starts_with?('/')
        found = controller_file(framework_root, "#{subdir}/#{ctrl_name}")
      end
      found || controller_file(framework_root, ctrl_name.lchop('/'))
    end

    # `<root>/<base>_controller.rb` in the first of the app's controller
    # roots that has it, the way Rails looks the constant up across its
    # autoload paths.
    private def controller_file(framework_root : String, base : String) : String?
      controller_roots(framework_root).each do |root|
        path = "#{root}/#{base}_controller.rb"
        return path if known_file?(path)
      end
      nil
    end

    # Every `app/controllers` directory the app autoloads controllers from:
    # its own first, then the others beneath it (an `enterprise/app` added
    # to `eager_load_paths`, a non-isolated engine's `app/controllers`).
    # One under a nested app with its own `config/routes.rb` is that app's.
    private def controller_roots(framework_root : String) : Array(String)
      @controller_roots[framework_root] ||= begin
        prefix = "#{framework_root}/"
        nested = @framework_roots.select { |root| root != framework_root && root.starts_with?(prefix) }
        extra = Set(String).new
        @known_files.each do |file|
          next unless file.starts_with?(prefix) && (idx = file.index("/app/controllers/", framework_root.size))
          dir = file[0, idx + "/app/controllers".size]
          extra << dir unless nested.any? { |root| dir.starts_with?("#{root}/") }
        end
        primary = "#{framework_root}/app/controllers"
        extra.delete(primary)
        [primary] + extra.to_a.sort!
      end
    end

    private def action_allowed?(name : String, only : Array(String), except : Array(String)) : Bool
      return false if !only.empty? && !only.includes?(name)
      return false if except.includes?(name)
      true
    end

    private def compose_url(prefix : String, suffix : String) : String
      return suffix if prefix.empty?
      "/#{prefix}#{suffix}"
    end
  end
end
