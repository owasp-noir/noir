/lib/
/.shards/
*.dwarf
.DS_Store
.vscode
ameba.sh

# Build artifacts
/bin/

# Claude Code local tooling state
/.claude/

# tree-sitter build artifacts (compiled on demand from vendored source)
src/ext/tree_sitter/**/*.o

# SwiftPM build artifacts (SourceKit regenerates these inside Swift fixtures)
.build/
.swiftpm/

# Ignore for Hwaro
/docs/public/

# Byte-cache from the docs CLI-screenshot renderer
__pycache__/

# Nix build result symlinks
/result
/result-*

# Scratch output of scripts/ (agent_bench clones, benchmark fixtures)
/tmp/

# npm wrapper: binary downloaded by packaging/npm/install.js, the per-release
# checksums the publish workflow generates, and the LICENSE copied in on pack
/packaging/npm/dist/
/packaging/npm/checksums.json
/packaging/npm/LICENSE
